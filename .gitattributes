# Normalize line endings for everyone, regardless of OS/editor config.
* text=auto eol=lf

# Never diff/merge generated or lock-style artifacts as text.
integrity/manifest-lock.json -diff
*.lock -diff

# GMP/audit reports are generated evidence, not hand-authored prose — keep
# them out of GitHub's linguist stats and PR diff noise.
reports/**/*.md linguist-generated=true
governance-health-report.json linguist-generated=true

# Shell scripts must always execute regardless of checkout platform.
*.sh text eol=lf

# Generated artifacts: conflicting text merges self-resolve via keep-ours +
# post-merge regeneration (sync_generated_artifacts.py --force). The driver is
# registered per-clone by ops/scripts/ensure_git_merge_drivers.sh; see
# rules/53-pr-overlap-guardrail.mdc. Attributes without a registered driver
# fall back to normal text merge — safe, just unresolved.
#
# skills/AUTONOMY_MANIFEST.yaml is intentionally NOT attributed: it is the
# hand-authored routing SSOT (only orphan-heal mutates it), and regeneration
# cannot restore hand-authored tier edits a keep-ours merge would drop (U3
# probe of the PR Conflict Guardrails plan).
rules/RULES-MANIFEST.* merge=l9-generated
environment/generated/llm-rules/** merge=l9-generated
ops/generated/skill-registry.json merge=l9-generated
environment/agents/adapters/claude-code/generated/skill-registry.json merge=l9-generated
environment/agents/adapters/claude-code/settings.template.json merge=l9-generated
.claude/settings.json merge=l9-generated
commands/COMMANDS_MANIFEST.yaml merge=l9-generated
environment/program-execution/core/MANIFEST.yaml merge=l9-generated
environment/program-execution/core/program-execution-blueprint-template/MANIFEST.yaml merge=l9-generated
environment/program-execution/core/program-execution-controller-template/MANIFEST.yaml merge=l9-generated
environment/program-execution/MANIFEST.json merge=l9-generated
