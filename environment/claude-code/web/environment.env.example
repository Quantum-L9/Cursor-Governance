# L9 Claude Code environment — Environment variables template (Web · Mobile).
#
# Paste into claude.ai/code -> your environment -> Environment variables, and
# replace every REPLACE_WITH_* placeholder IN THE UI (never in chat or a repo).
# Account-level: Claude Code Mobile inherits these. New sessions only.
#
# SECURITY: env vars are stored in the environment config in plaintext, visible to
# anyone who can edit it. Use least-privilege, dedicated bot credentials, and rotate
# any token ever pasted into a chat. A committed .env in a repo is a leaked secret.

# --- GitHub (required for gh-driven skills: CI logs, reviews, pushes) --------
# A fine-grained PAT from a DEDICATED BOT USER account (not a GitHub App, not the
# Actions GITHUB_TOKEN). A user PAT's pushes fire push/PR workflows, so CI re-runs
# on the pipeline's own commits. Scopes: Contents:write, Pull requests:write,
# Workflows:write on the target repos. Add the bot to an org team so it is not an
# outside/first-time contributor.
GH_TOKEN=REPLACE_WITH_BOT_USER_FINE_GRAINED_PAT

# --- Governance SSOT (GitHub main) -------------------------------------------
# setup.sh always clones/syncs Quantum-L9/Cursor-Governance @ main to
# $HOME/.cursor-governance (this var is informational; other paths are ignored).
L9_GOVERNANCE_DIR=$HOME/.cursor-governance
# Optional overrides (defaults are correct):
# L9_GOVERNANCE_REMOTE=https://github.com/Quantum-L9/Cursor-Governance.git
# L9_GOVERNANCE_BRANCH=main

# --- Shared agent memory (optional; only if using l9-shared-memory) ----------
# The bearer credential is a memory-CLIENT token (read/write, non-admin). It is a
# secret: keep it here, never in a repo or .mcp.json. Point the URL at the shared
# HTTP memory server on a ROUTABLE HTTPS host (Option A in MEMORY_TOPOLOGY.md).
# Loopback (http://127.0.0.1:8200) shares only within one host/container and is
# UNREACHABLE from Claude Code Web/Mobile sandboxes — do not use it here; it exists
# only for single-machine CLI work. See web/network-policy.md for the allowlist.
L9_MEMORY_HTTP_URL=https://memory.quantumaipartners.com
L9_MEMORY_CLIENT_TOKEN=REPLACE_WITH_MEMORY_CLIENT_BEARER_TOKEN

# --- Memory IDENTITY (must be unique to Claude Code) -------------------------
# group_id (repo namespace) is shared across agents; writing identity is not.
# Use the values below — never USER_ID=cursor_agent / L9_MEMORY_AGENT_ID=cursor_agent.
USER_ID=claude_code_agent
L9_MEMORY_AGENT_ID=claude-code
L9_MEMORY_SOURCE=claude-code

# --- Bounded autonomy: open PRs + drive them to green (merge stays human) -----
# Authority (A4) and maturity (M4) are separate axes: A4 permits campaign-scoped
# external writes; M4 requires proof and assurance gates. Default posture:
#   * ENABLED: complete work -> open a PR -> remediate CI until green, unattended.
#   * The runtime schedules only dependency-ready, non-conflicting actions
#     (two mutation lanes) and remediates via the l9-pr-remediation skill.
#   * AUTONOMOUS_MERGE=false: the agent proves merge_gate eligibility but a HUMAN
#     approves every merge (merge_pull_request is omitted from settings allow, so
#     it prompts). Set to true only with distribution-owner sign-off + an ADR.
L9_AUTONOMY_ENABLED=true
L9_AUTONOMY_AUTHORITY=A4_CAMPAIGN_BOUNDED_EXTERNAL_WRITE
L9_AUTONOMY_MATURITY=M4_ASSURANCE_GOVERNED
L9_AUTONOMY_PROFILE=pr-convergence
L9_AUTONOMY_AUTONOMOUS_MERGE=false
L9_AUTONOMY_REMEDIATION_SKILL=l9-pr-remediation
L9_AUTONOMY_MAX_PARALLEL=4
L9_AUTONOMY_MAX_MUTATION_LANES=2
L9_AUTONOMY_STATE_DIR=.l9/autonomy
L9_DISCOVER_BEFORE_ASK=true
L9_REQUIRE_EXACT_SHA_GREEN=true

# --- Optional: code scanners (add only if the repo's gate uses them) ---------
# SONAR_TOKEN=REPLACE_WITH_ROTATED_SONAR_TOKEN
# SONAR_ORG_KEY=quantum-l9
# SONAR_PROJECT_KEY=REPLACE_WITH_REPO_SONAR_PROJECT_KEY

# --- Toolchain hygiene (safe, non-secret) ------------------------------------
PYTHONDONTWRITEBYTECODE=1
PIP_DISABLE_PIP_VERSION_CHECK=1
NPM_CONFIG_FUND=false
NPM_CONFIG_AUDIT=false
