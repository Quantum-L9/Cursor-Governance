{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-l9.dev/schemas/claude-code/action-graph.schema.json",
  "title": "L9 Claude Code Concurrent Action Graph",
  "type": "object",
  "additionalProperties": false,
  "required": ["campaign_id", "objective", "actions"],
  "properties": {
    "campaign_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
    "objective": {"type": "string", "minLength": 1},
    "authority_profile": {"type": "string", "minLength": 1, "default": "pr-convergence"},
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action_id", "objective", "depends_on", "resources", "mutation"],
        "properties": {
          "action_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
          "objective": {"type": "string", "minLength": 1},
          "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
          "resources": {
            "type": "array",
            "items": {"$ref": "resource-contract.schema.json#/$defs/resourceLock"}
          },
          "mutation": {"type": "boolean"},
          "authority_granted": {"type": "boolean", "default": true},
          "preconditions_satisfied": {"type": "boolean", "default": true},
          "priority": {"type": "integer", "default": 0},
          "critical_path_weight": {"type": "integer", "default": 0},
          "downstream_unlocks": {"type": "integer", "minimum": 0, "default": 0},
          "reversibility_score": {"type": "integer", "minimum": 0, "maximum": 5, "default": 0},
          "validation_strength": {"type": "integer", "minimum": 0, "maximum": 5, "default": 0},
          "blast_radius": {"type": "integer", "minimum": 0, "maximum": 5, "default": 0},
          "operation_id": {"type": ["string", "null"]},
          "join_group": {"type": ["string", "null"]}
        }
      }
    },
    "runtime": {"type": "object", "additionalProperties": {"type": "object"}},
    "completed_operations": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "checkpoints": {"type": "array", "items": {"type": "object"}},
    "state_digest": {"type": "string"}
  }
}
