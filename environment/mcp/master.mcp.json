{
  "_comment": [
    "MASTER MCP for the Cursor (CLI) plane — NOT Claude Code.",
    "Authority: ~/.cursor-governance/environment/mcp/master.mcp.json",
    "Wired to Cursor as ~/.cursor/mcp.json (symlink).",
    "",
    "The capability broker never shipped (2026-08-29). Do not point any server",
    "at ${L9_CAPABILITY_BROKER_URL}. GitHub / Context7 / Semgrep / GitGuardian",
    "are Cursor-native MCP installs (marketplace / user mcp.json), not this file.",
    "",
    "Claude Code Web/Mobile uses environment/agents/adapters/claude-code/",
    "mcp.template.json → ${GRAPHITI_MCP_URL} only. Do not merge those planes.",
    "",
    "graphiti-memory here is the operator SSH tunnel (127.0.0.1:8100), not the",
    "cloud HTTPS front door."
  ],
  "mcpServers": {
    "n8n-workflows Docs": {
      "command": "npx",
      "args": [
        "mcp-remote",
        "https://gitmcp.io/Zie619/n8n-workflows"
      ]
    },
    "Playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest"]
    },
    "firecrawl-mcp": {
      "command": "npx",
      "args": ["-y", "firecrawl-mcp"],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    },
    "Tavily Expert": {
      "url": "${TAVILY_MCP_URL}"
    },
    "graphiti-memory": {
      "url": "http://127.0.0.1:8100/mcp",
      "timeout": 120000,
      "alwaysLoad": true
    }
  }
}
