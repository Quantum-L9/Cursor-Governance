{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://quantum-l9.dev/schemas/claude-code/memory-enforcement.schema.json",
  "title": "L9 Claude Code memory enforcement contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract",
    "version",
    "status",
    "memory",
    "interactive_memory_write",
    "state",
    "enforcement_point",
    "hooks",
    "preconditions",
    "governed_writes",
    "operator_override",
    "repository_authority"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "contract": {
      "const": "l9.claude-code.memory-enforcement"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "enum": [
        "enforced",
        "disabled"
      ]
    },
    "summary": {
      "type": "string"
    },
    "memory": {
      "type": "object",
      "additionalProperties": false,
      "description": "The canonical front door only. A provider URL env, token env or MCP path is retired doctrine (realignment C9/C11, ADR-0030) and is deliberately not a legal property.",
      "required": [
        "front_door",
        "bridge",
        "control_plane_contract",
        "default_namespaces",
        "forbidden_side_doors"
      ],
      "properties": {
        "front_door": {
          "const": "ops/memory/control_plane_client.py"
        },
        "bridge": {
          "type": "string",
          "pattern": "memory/memory_bridge\\.py$"
        },
        "mcp_template": {
          "type": "string"
        },
        "control_plane_contract": {
          "const": "memory-control-plane/v1"
        },
        "agent_id_env": {
          "type": "string"
        },
        "default_agent_id": {
          "type": "string"
        },
        "namespace_env": {
          "type": "string"
        },
        "default_namespaces": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "forbidden_side_doors": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "interactive_memory_write": {
      "type": "object",
      "additionalProperties": false,
      "description": "The model-initiated durable-write contract (ADR-0030 items 7-9, CANONICAL_LAW 8.3). Every const below is doctrine: a different value is a regression, not a configuration.",
      "required": [
        "canonical_mcp_server",
        "prerequisite",
        "write_operation",
        "repository_authority",
        "provider_direct",
        "generic_ingest_as_model_write",
        "cli_adapter",
        "cli_write_role",
        "deterministic_adapter_operations"
      ],
      "properties": {
        "canonical_mcp_server": {
          "const": "l9-graphite-memory"
        },
        "prerequisite": {
          "const": "memory.phase_lock"
        },
        "write_operation": {
          "const": "memory.write_governed"
        },
        "repository_authority": {
          "const": false
        },
        "provider_direct": {
          "const": "forbidden"
        },
        "generic_ingest_as_model_write": {
          "const": "forbidden"
        },
        "cli_adapter": {
          "const": "python -m ops.memory.cli"
        },
        "cli_write_role": {
          "const": "operator_and_deterministic_adapters"
        },
        "deterministic_adapter_operations": {
          "type": "array",
          "items": {
            "enum": [
              "hydrate",
              "close",
              "ingest_candidate",
              "repair-write",
              "legacy_reconciliation",
              "readiness"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "authority": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "note": {
          "type": "string"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "session_ttl_seconds"
      ],
      "properties": {
        "root": {
          "type": "string"
        },
        "session_receipt_glob": {
          "type": "string"
        },
        "session_ttl_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "enforcement_point": {
      "const": "PreToolUse"
    },
    "hooks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefetch",
        "gate",
        "writeback"
      ],
      "properties": {
        "prefetch": {
          "$ref": "#/definitions/hook"
        },
        "gate": {
          "$ref": "#/definitions/hook"
        },
        "writeback": {
          "$ref": "#/definitions/hook"
        }
      }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "session_prefetch"
      ],
      "properties": {
        "session_prefetch": {
          "$ref": "#/definitions/precondition"
        }
      }
    },
    "governed_writes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "match",
          "requires",
          "fail_mode"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "tools"
            ],
            "properties": {
              "tools": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "minItems": 1
              },
              "path_globs": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "command_patterns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          },
          "requires": {
            "type": "array",
            "items": {
              "enum": [
                "session_prefetch"
              ]
            },
            "minItems": 1,
            "description": "Repository-write authority comes from Git isolation, not memory state. 'phase_lock' is deliberately not a legal value."
          },
          "fail_mode": {
            "enum": [
              "closed",
              "open"
            ]
          }
        }
      }
    },
    "operator_override": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "env",
        "agent_settable"
      ],
      "properties": {
        "env": {
          "type": "string"
        },
        "agent_settable": {
          "const": false
        },
        "note": {
          "type": "string"
        }
      }
    },
    "disable_env": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "env",
        "agent_settable"
      ],
      "properties": {
        "env": {
          "type": "string"
        },
        "agent_settable": {
          "const": false
        },
        "note": {
          "type": "string"
        }
      }
    },
    "repository_authority": {
      "type": "object",
      "description": "Authorities that must not be substituted for one another (rules/96-multi-agent-main-bound-execution.mdc).",
      "required": [
        "repository_isolation",
        "collision_detection",
        "prohibited"
      ],
      "properties": {
        "note": {
          "type": "string"
        },
        "shared_knowledge": {
          "type": "string"
        },
        "repository_isolation": {
          "type": "string"
        },
        "task_ancestry": {
          "type": "string"
        },
        "publication": {
          "type": "string"
        },
        "collision_detection": {
          "type": "string"
        },
        "integration": {
          "type": "string"
        },
        "prohibited": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    }
  },
  "definitions": {
    "hook": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "script",
        "fail_mode"
      ],
      "properties": {
        "event": {
          "enum": [
            "SessionStart",
            "PreToolUse",
            "Stop"
          ]
        },
        "script": {
          "type": "string"
        },
        "fail_mode": {
          "enum": [
            "closed",
            "open"
          ]
        },
        "note": {
          "type": "string"
        }
      }
    },
    "precondition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "satisfied_by"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "satisfied_by": {
          "type": "string"
        },
        "established_by": {
          "type": "string"
        },
        "verifies_against": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gate_shape": {
          "type": "string",
          "description": "The permitted shape of this precondition as a gate, stated so the contract carries it rather than relying on prose elsewhere."
        },
        "note": {
          "type": "string",
          "description": "Binding clarification of what this precondition may and may not gate."
        }
      }
    }
  }
}
