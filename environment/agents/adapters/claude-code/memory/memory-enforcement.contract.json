{
  "$schema": "./memory-enforcement.schema.json",
  "contract": "l9.claude-code.memory-enforcement",
  "version": "1.0.0",
  "status": "enforced",
  "summary": "Memory prefetch and conflict-checked phase-locks are preconditions for governed writes on the Claude Code surface. Single front door: Cursor Graphiti (ops/graphiti/graphiti_memory_client.py) via thin hooks. Enforced at PreToolUse. Operator-only breakglass: L9_MEMORY_ENFORCEMENT_BREAKGLASS. No ENFORCEMENT=off side door.",
  "memory": {
    "front_door": "ops/graphiti/graphiti_memory_client.py",
    "bridge": "environment/agents/adapters/claude-code/memory/graphiti_bridge.py",
    "mcp_template": "environment/agents/adapters/claude-code/mcp.template.json",
    "agent_id_env": "L9_MEMORY_AGENT_ID",
    "default_agent_id": "claude-code",
    "namespace_env": "L9_MEMORY_NAMESPACES",
    "default_namespaces": [
      "cursor-governance"
    ],
    "forbidden_side_doors": [
      "L9_MEMORY_HTTP_URL",
      "L9_MEMORY_CLIENT_TOKEN",
      "environment/agents/adapters/claude-code/memory/memory_client.py",
      "l9-shared-memory@memory.quantumaipartners.com",
      "L9_MEMORY_ENFORCEMENT=off"
    ]
  },
  "state": {
    "root": ".l9/memory",
    "session_receipt_glob": ".l9/memory/receipts/*.json",
    "lock_glob": ".l9/memory/locks/*.json",
    "session_ttl_seconds": 86400,
    "lock_ttl_seconds": 3600
  },
  "enforcement_point": "PreToolUse",
  "hooks": {
    "prefetch": {
      "event": "SessionStart",
      "script": "environment/agents/adapters/claude-code/hooks/memory_prefetch.py",
      "fail_mode": "open",
      "note": "SessionStart thin wrap of Cursor Graphiti inject. Writes receipt on success. Fail-open."
    },
    "gate": {
      "event": "PreToolUse",
      "script": "environment/agents/adapters/claude-code/hooks/memory_gate.py",
      "fail_mode": "closed",
      "note": "Emits a PreToolUse permissionDecision. Denies a matched governed write when its required preconditions are unmet."
    },
    "writeback": {
      "event": "Stop",
      "script": "environment/agents/adapters/claude-code/hooks/memory_writeback.py",
      "fail_mode": "open",
      "note": "Stop thin wrap of Cursor Graphiti write --kind session_summary. Fail-open."
    }
  },
  "preconditions": {
    "session_prefetch": {
      "id": "session_prefetch",
      "satisfied_by": "a session receipt under state.session_receipt_glob whose session_id matches the current session and whose age is < state.session_ttl_seconds",
      "established_by": "environment/agents/adapters/claude-code/hooks/memory_prefetch.py"
    },
    "phase_lock": {
      "id": "phase_lock",
      "satisfied_by": "a lock artifact under state.lock_glob for at least one required namespace, conflict-checked, unexpired (< state.lock_ttl_seconds), and bound to the current session",
      "established_by": "environment/agents/adapters/claude-code/hooks/memory_lock.py acquire --namespace <ns> --task <text>",
      "verifies_against": [
        "graphiti conflicts",
        "graphiti phase-lock",
        "local lock transport=cursor-graphiti-phase-lock"
      ]
    }
  },
  "governed_writes": [
    {
      "id": "edit-authority-files",
      "description": "Edits to governance-authority paths require prefetch and a conflict-checked phase-lock.",
      "match": {
        "tools": [
          "Edit",
          "Write",
          "NotebookEdit"
        ],
        "path_globs": [
          "CANONICAL_LAW.md",
          "AGENTS.md",
          "ORG_INVARIANTS.yaml",
          "skills/**",
          "rules/**",
          "environment/**",
          "ops/**",
          "workflows/**",
          ".github/**",
          "docs/decisions/**",
          ".claude/**"
        ]
      },
      "requires": [
        "session_prefetch",
        "phase_lock"
      ],
      "fail_mode": "closed"
    },
    {
      "id": "edit-other",
      "description": "Any other edit still requires that memory was prefetched this session.",
      "match": {
        "tools": [
          "Edit",
          "Write",
          "NotebookEdit"
        ],
        "path_globs": [
          "**"
        ]
      },
      "requires": [
        "session_prefetch"
      ],
      "fail_mode": "closed"
    },
    {
      "id": "git-mutation",
      "description": "Local history mutation and publication require prefetch and a phase-lock.",
      "match": {
        "tools": [
          "Bash"
        ],
        "command_patterns": [
          "(^|\\s|&&|;|\\|)\\s*git\\s+(commit|push|merge|rebase|tag)\\b"
        ]
      },
      "requires": [
        "session_prefetch",
        "phase_lock"
      ],
      "fail_mode": "closed"
    },
    {
      "id": "external-write",
      "description": "External GitHub writes (PR create/update, merge, direct file push) require prefetch and a phase-lock.",
      "match": {
        "tools": [
          "mcp__github__create_pull_request",
          "mcp__github__update_pull_request",
          "mcp__github__merge_pull_request",
          "mcp__github__push_files",
          "mcp__github__create_or_update_file",
          "mcp__github__delete_file"
        ]
      },
      "requires": [
        "session_prefetch",
        "phase_lock"
      ],
      "fail_mode": "closed"
    }
  ],
  "operator_override": {
    "env": "L9_MEMORY_ENFORCEMENT_BREAKGLASS",
    "agent_settable": false,
    "note": "Admin/operator-only key to the back door. Non-empty reason allows governed writes and appends .l9/memory/overrides.jsonl. Agents cannot set this for their own hooks. There is no L9_MEMORY_ENFORCEMENT=off escape hatch."
  }
}
