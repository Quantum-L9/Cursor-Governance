{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": [
    "Committable .claude/settings.json for an L9 consumer repo. Copy to .claude/settings.json",
    "and commit it: on Claude Code Web/Mobile only git-tracked files survive the clone, so a",
    "committed settings.json is what makes governance boot with no manual step. On the CLI the",
    "same file is picked up locally. Keep secrets OUT of this file \u2014 they belong in the account",
    "environment (web/environment.env.example) or user-scope config, never in a repo.",
    "Field/event names track the Claude Code release; see https://code.claude.com/docs.",
    "permissions.allow lets the bounded-autonomy runtime complete work end to end: scoped git",
    "writes (branch/worktree/commit), CI inspection (gh run/pr checks), read-only GitHub",
    "queries, PR monitoring (subscribe/unsubscribe), and `make pr` \u2014 so completed work",
    "opens a PR and is driven to green via the l9-pr-remediation loop WITHOUT a prompt.",
    "PUBLISH PATH: `PR_REMEDIATE=0 make pr` is the ONLY sanctioned route to GitHub. It runs",
    "the Makefile checkers, then pushes and opens the PR. Raw `git push`, `gh pr create`,",
    "`gh pr edit` and the MCP create_pull_request/push_files tools are in deny BECAUSE they",
    "skip those checkers. This allow/deny split is not advisory: it must agree with",
    "ops/autonomy/local_execution_gate.py, and validate_claude_env.py fails when it does not.",
    "An allow entry here is what an agent reads as 'approved, no prompt' \u2014 so listing a",
    "forbidden action here teaches the agent to attempt it and get denied a layer later.",
    "Autonomous merge is deliberately OFF: merge_pull_request is omitted from allow so a human",
    "still approves every merge (see L9_AUTONOMY_AUTONOMOUS_MERGE=false). Force pushes, hard",
    "resets, destructive cleanup, and admin-merge overrides are denied outright."
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=\"$CLAUDE_PROJECT_DIR/.claude/hooks/session_start_claude_governance.sh\"; [ -f \"$f\" ] && exec bash \"$f\" || exit 0'",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bash -c 'f=\"$HOME/.cursor-governance/environment/agents/adapters/claude-code/hooks/memory_prefetch.py\"; [ -f \"$f\" ] && exec python3 \"$f\" || exit 0'",
            "timeout": 25
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=\"$HOME/.cursor-governance/environment/agents/adapters/claude-code/hooks/memory_writeback.py\"; [ -f \"$f\" ] && exec python3 \"$f\" || exit 0'",
            "timeout": 20
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=\"$HOME/.cursor-governance/environment/agents/adapters/claude-code/hooks/user_prompt_skill_router.py\"; [ -f \"$f\" ] && exec python3 \"$f\" || exit 0'",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=\"$HOME/.cursor-governance/environment/agents/adapters/claude-code/hooks/skill_usage_logger.py\"; [ -f \"$f\" ] && exec python3 \"$f\" || exit 0'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Bash|mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=\"$HOME/.cursor-governance/environment/agents/adapters/claude-code/hooks/merge_gate_wrap.py\"; [ -f \"$f\" ] && exec python3 \"$f\" || exit 0'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash -c 'f=\"$HOME/.cursor-governance/environment/agents/adapters/claude-code/hooks/local_execution_gate_wrap.py\"; [ -f \"$f\" ] && exec python3 \"$f\" || exit 0'",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|Bash|mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=\"$HOME/.cursor-governance/environment/agents/adapters/claude-code/hooks/memory_gate.py\"; [ -f \"$f\" ] && exec python3 \"$f\" || exit 0'",
            "timeout": 12
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=\"$HOME/.cursor-governance/environment/agents/adapters/claude-code/hooks/skill_usage_logger.py\"; [ -f \"$f\" ] && exec python3 \"$f\" || exit 0'",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git fetch:*)",
      "Bash(git switch:*)",
      "Bash(git checkout:*)",
      "Bash(git branch:*)",
      "Bash(git worktree:*)",
      "Bash(git add --:*)",
      "Bash(git commit:*)",
      "Bash(make pr:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",
      "Bash(gh run rerun:*)",
      "Bash(make claude-env:*)",
      "mcp__github__pull_request_read",
      "mcp__github__get_check_run",
      "mcp__github__actions_get",
      "mcp__github__actions_list",
      "mcp__github__get_job_logs",
      "mcp__github__get_commit",
      "mcp__github__list_commits",
      "mcp__github__list_pull_requests",
      "mcp__github__search_pull_requests",
      "mcp__github__get_file_contents",
      "mcp__github__list_branches",
      "mcp__github__list_tags",
      "mcp__github__list_releases",
      "mcp__github__get_latest_release",
      "mcp__github__get_me",
      "mcp__github__issue_read",
      "mcp__github__list_issues",
      "mcp__github__search_issues",
      "mcp__github__search_code",
      "mcp__github__subscribe_pr_activity",
      "mcp__github__unsubscribe_pr_activity",
      "mcp__github__update_pull_request"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.mcp.json)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(make push:*)",
      "mcp__github__create_pull_request",
      "mcp__github__push_files",
      "Bash(git reset --hard:*)",
      "Bash(git clean -fd:*)",
      "Bash(gh pr merge --admin:*)"
    ]
  },
  "env": {
    "L9_GOVERNANCE_SURFACE": "claude-code",
    "L9_AUTONOMY_ENABLED": "true",
    "L9_AUTONOMY_AUTHORITY": "A4_CAMPAIGN_BOUNDED_EXTERNAL_WRITE",
    "L9_AUTONOMY_MATURITY": "M4_ASSURANCE_GOVERNED",
    "L9_AUTONOMY_PROFILE": "pr-convergence",
    "L9_AUTONOMY_AUTONOMOUS_MERGE": "false",
    "L9_AUTONOMY_REMEDIATION_SKILL": "l9-pr-remediation",
    "L9_AUTONOMY_MAX_PARALLEL": "4",
    "L9_AUTONOMY_MAX_MUTATION_LANES": "2",
    "L9_AUTONOMY_STATE_DIR": ".l9/autonomy",
    "L9_DISCOVER_BEFORE_ASK": "true",
    "L9_REQUIRE_EXACT_SHA_GREEN": "true",
    "L9_PROACTIVE_SKILLS": "true",
    "L9_SKILL_USAGE_LOGGING": "true"
  },
  "skillOverrides": {
    "l9-bounded-autonomy": "user-invocable-only",
    "l9-chat-extraction": "user-invocable-only",
    "l9-ci-ops": "user-invocable-only",
    "l9-cli-optimization": "user-invocable-only",
    "l9-code-maintenance": "user-invocable-only",
    "l9-component-verification": "user-invocable-only",
    "l9-dag-authoring": "user-invocable-only",
    "l9-e2e-blocker-resolution": "user-invocable-only",
    "l9-end-session": "user-invocable-only",
    "l9-forge": "user-invocable-only",
    "l9-git-work-preserve": "user-invocable-only",
    "l9-governance-symlinks": "user-invocable-only",
    "l9-governance-wiring": "user-invocable-only",
    "l9-harvest-pipeline": "user-invocable-only",
    "l9-inspect": "user-invocable-only",
    "l9-issue-remediation": "user-invocable-only",
    "l9-kubernetes-deploying": "user-invocable-only",
    "l9-mac-storage-triage": "user-invocable-only",
    "l9-pr-remediation": "user-invocable-only",
    "l9-python-tdd-with-uv": "user-invocable-only",
    "l9-repo-index": "user-invocable-only",
    "l9-repository-renovation": "user-invocable-only",
    "l9-setting-up-terraform": "user-invocable-only",
    "l9-ui-operator": "user-invocable-only",
    "l9-update-command": "user-invocable-only"
  }
}
