{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-l9.dev/schemas/claude-code/join-barrier.schema.json",
  "title": "L9 Concurrent Fan-In Assurance Barrier",
  "type": "object",
  "additionalProperties": false,
  "required": ["join_id", "member_actions", "policy", "required_proof_keys"],
  "properties": {
    "join_id": {"type": "string", "minLength": 1},
    "member_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "policy": {"type": "string", "enum": ["all", "any", "threshold"]},
    "threshold": {"type": ["integer", "null"], "minimum": 1},
    "required_proof_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "conflict_check_required": {"type": "boolean", "default": true},
    "integration_validation_required": {"type": "boolean", "default": true},
    "downstream_unlocks": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"policy": {"const": "threshold"}}},
      "then": {"required": ["threshold"]}
    }
  ]
}
