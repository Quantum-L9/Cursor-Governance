{
  "_comment": [
    "Claude Code MCP configuration — capability broker architecture",
    "Authority: environment/agents/adapters/claude-code/mcp.template.json",
    "",
    "Credential-bearing MCPs reach upstream APIs through the L9 capability broker.",
    "The broker holds secrets; this surface holds only capability IDs.",
    "NO CREDENTIALS in this file or in environment.env — the broker authenticates",
    "this session with the platform-issued workload JWT (CLAUDE_SESSION_JWT).",
    "",
    "Graphiti memory remains direct (separate bearer + Caddy proxy).",
    "Set L9_CAPABILITY_BROKER_URL in environment.env to the cloud broker URL."
  ],
  "mcpServers": {
    "GitHub": {
      "url": "${L9_CAPABILITY_BROKER_URL}/mcp",
      "headers": {
        "X-Capability-Id": "github.mcp",
        "Authorization": "${CLAUDE_SESSION_JWT}"
      },
      "timeout": 30000
    },
    "Context7": {
      "url": "${L9_CAPABILITY_BROKER_URL}/mcp",
      "headers": {
        "X-Capability-Id": "context7.mcp",
        "Authorization": "${CLAUDE_SESSION_JWT}"
      },
      "timeout": 30000
    },
    "Semgrep": {
      "url": "${L9_CAPABILITY_BROKER_URL}/mcp",
      "headers": {
        "X-Capability-Id": "semgrep.mcp",
        "Authorization": "${CLAUDE_SESSION_JWT}"
      },
      "timeout": 30000
    },
    "GitGuardian": {
      "url": "${L9_CAPABILITY_BROKER_URL}/mcp",
      "headers": {
        "X-Capability-Id": "gitguardian.mcp",
        "Authorization": "${CLAUDE_SESSION_JWT}"
      },
      "timeout": 30000
    },
    "Playwright": {
      "url": "${L9_CAPABILITY_BROKER_URL}/mcp",
      "headers": {
        "X-Capability-Id": "playwright.mcp",
        "Authorization": "${CLAUDE_SESSION_JWT}"
      },
      "timeout": 30000
    },
    "graphiti-memory": {
      "url": "${GRAPHITI_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${GRAPHITI_MCP_TOKEN}"
      },
      "timeout": 120000,
      "alwaysLoad": true
    }
  }
}
