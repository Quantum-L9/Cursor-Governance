{
  "schema": "l9.manus.infisical-capabilities.v1",
  "capabilities": {
    "github.get_repository": {
      "description": "Read repository metadata from the GitHub REST API using the configured GITHUB_TOKEN. This capability cannot modify GitHub resources.",
      "secret_key": "GITHUB_TOKEN",
      "origin": "https://api.github.com",
      "method": "GET",
      "path_template": "/repos/{owner}/{repo}",
      "arguments": {
        "owner": "[A-Za-z0-9](?:[A-Za-z0-9-]{0,37}[A-Za-z0-9])?",
        "repo": "[A-Za-z0-9._-]{1,100}"
      },
      "response_fields": [
        "id",
        "node_id",
        "name",
        "full_name",
        "private",
        "html_url",
        "description",
        "fork",
        "archived",
        "disabled",
        "visibility",
        "default_branch",
        "created_at",
        "updated_at",
        "pushed_at",
        "license"
      ]
    }
  }
}
