{
  "_l9_meta": {
    "l9_schema": 1,
    "repo": "Quantum-L9/Cursor-Governance",
    "path": "environment/agents/adapters/manus/mcp-connector.json",
    "layer": "adapter-config",
    "owner": "governance-control-plane",
    "status": "active",
    "version": "6.0.0",
    "updated": "2026-11-05",
    "note": "No-secret governance carrier. Optional bearer-protected Memory compatibility stubs report UPSTREAM_BLOCKED only; this server is neither a native Memory client nor a credential carrier. Governance and native Memory authentication are distinct."
  },
  "name": "l9-governance",
  "transport": "streamable-http",
  "endpoint_path": "/mcp",
  "health_path": "/health",
  "authentication": {
    "default": "none-read-only-governance-tools",
    "bootstrap_requires": "bearer-token-file",
    "apply_bootstrap_requires": "bearer-token-file plus --allow-bootstrap-apply"
  },
  "memory": {
    "agent_lane": "native-authenticated-streamable-http-UPSTREAM_BLOCKED",
    "lifecycle": "bearer-protected-blocked-compatibility-stubs",
    "startup": "health-only-on-demand-no-write-precondition",
    "fallback": "fail-closed-no-local-operator-identity"
  },
  "safety": {
    "no_shell": true,
    "no_credentials": true,
    "no_arbitrary_file_access": true,
    "no_repository_write_tools": true
  },
  "retired_server_keys": ["graphiti-memory"]
}
