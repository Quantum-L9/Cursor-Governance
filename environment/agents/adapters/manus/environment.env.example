# L9 Manus cloud environment — model-controlled surface
#
# Copy these values into the Manus project or session environment. A hosted
# environment stores values literally: do not add a $HOME-based path here.
# Every value is safe for model visibility; this file intentionally contains no
# credential, bearer, provider URL, capability-broker address, or breakglass.
# Identity values are rendered from environment/agents/agent_registry.yaml.

# --- Governance discovery and immutable surface identity ---------------------
L9_GOVERNANCE_REPO=Quantum-L9/Cursor-Governance
L9_GOVERNANCE_SURFACE=manus
USER_ID=manus_agent
L9_MEMORY_AGENT_ID=manus
L9_MEMORY_SOURCE=manus
L9_AGENT_ROLE=researcher-builder

# L9_GOVERNANCE_DIR is deliberately absent. Hosted environment fields do not
# expand $HOME. The thin installer resolves the governance checkout explicitly.
# L9_MEMORY_INTERPRETER and signed-memory-door variables are deliberately
# absent. The protected lifecycle service resolves them before launch from the
# local scoped assertion maps; no memory credential reaches a Manus project env.
# Cross-chat `l9-memory-manus` authority is connector-only: its encrypted
# Custom MCP environment may hold the approved Manus-scoped map, which the
# launcher materializes privately for its child process and removes on exit.

# --- Shared autonomy configuration --------------------------------------------
# The authority and enforcement live upstream in ops/autonomy/
# surface_profile.yaml. This enables only the existing Manus standing authority;
# it never authorizes merge, force push, raw-secret access, or a direct provider.
L9_AUTONOMY_ENABLED=true
L9_AUTONOMY_AUTHORITY=A4_CAMPAIGN_BOUNDED_EXTERNAL_WRITE
L9_AUTONOMY_MATURITY=M4_ASSURANCE_GOVERNED
L9_AUTONOMY_PROFILE=pr-convergence
L9_AUTONOMY_REMEDIATION_SKILL=l9-pr-remediation
L9_L4_LOCAL_AUTONOMY=1
L9_WORKTREE_ISOLATION=1
L9_DISCOVER_BEFORE_ASK=true
L9_REQUIRE_EXACT_SHA_GREEN=true

# --- Shared toolchain hygiene -------------------------------------------------
PYTHONDONTWRITEBYTECODE=1
PIP_DISABLE_PIP_VERSION_CHECK=1
PYTHONUNBUFFERED=1
NPM_CONFIG_FUND=false
NPM_CONFIG_AUDIT=false

# --- Deliberately absent -------------------------------------------------------
# Do not add raw credentials or permanent bypasses. The shared bootstrap reports
# unavailable named capabilities honestly and the session continues degraded.
#   GRAPHITI_MCP_URL / GRAPHITI_MCP_TOKEN
#   L9_MEMORY_HTTP_URL / L9_MEMORY_CLIENT_TOKEN
#   L9_CAPABILITY_BROKER_URL
#   INFISICAL_CLIENT_SECRET / INFISICAL_TOKEN
#   SONAR_TOKEN / SEMGREP_APP_TOKEN / AWS_ACCESS_KEY_ID
#   L9_MERGE_AUTHORIZED / L9_PUBLISH_PATH_OVERRIDE / PR_REMEDIATE
