#
# Manus agent identity — RENDERED FROM agent_registry.yaml (agents.manus).
# Do not hand-edit identity values; change the registry and re-render.
# Set these in the Manus connector/session environment. Placeholders in
# <angle-brackets> are secrets/deployment values — NEVER commit real values.

# --- Shared memory endpoint (docs/MEMORY_TOPOLOGY.md Option A) ---
L9_MEMORY_HTTP_URL=https://<memory-host>          # routable HTTPS; loopback unreachable from Manus
L9_MEMORY_CLIENT_TOKEN=<value of L9_MEMORY_TOKEN__MANUS>   # this agent's own bearer token

# --- Writing identity (unique per agent; from registry) ---
USER_ID=manus_agent
L9_MEMORY_AGENT_ID=manus
L9_MEMORY_SOURCE=manus

# --- Role (informational; hard grants live server-side in auth_tokens.json) ---
L9_AGENT_ROLE=researcher-builder

# --- Governance discovery ---
L9_GOVERNANCE_REPO=Quantum-L9/Cursor-Governance
