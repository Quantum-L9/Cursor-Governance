#
# Manus agent identity — RENDERED FROM agent_registry.yaml (agents.manus).
# Do not hand-edit identity values; change the registry and re-validate.
# Set these in the Manus connector/session environment. REPLACE_* is a secret
# placeholder — NEVER commit a real bearer token.

# --- Shared memory (production HTTPS control plane) ---
GRAPHITI_MCP_URL=https://memory.quantumaipartners.com/graphiti/mcp
# GRAPHITI_MCP_TOKEN is deliberately ABSENT. This surface reaches memory through
# GRAPHITI_MCP_URL with no bearer. Pasting a bearer here is a contract violation
# (S3, §12). The capability-broker experiment never shipped.

# --- Writing identity (unique per agent; from registry) ---
USER_ID=manus_agent

# --- Role (informational; hard grants live server-side in auth_tokens.json) ---
L9_AGENT_ROLE=researcher-builder

# --- Governance discovery ---
L9_GOVERNANCE_REPO=Quantum-L9/Cursor-Governance
L9_GOVERNANCE_DIR=$HOME/.cursor-governance
L9_MEMORY_AGENT_ID=manus
L9_MEMORY_SOURCE=manus

# --- Canonical secret bootstrap (shared by ALL agent surfaces) ----------------
# Bootstrap credentials ONLY. Every downstream token (SONAR_TOKEN,
# SEMGREP_APP_TOKEN, GITHUB_TOKEN, ...) is registered in ops/secrets and
# resolved at run time — never copied into an adapter env file.
#   bash ops/secrets/bootstrap_agent_env.sh --check --surface <this-surface>
# --- Canonical capability plane (retired) -------------------------------------
# NO CREDENTIALS BELONG IN THIS FILE. Infisical remains the secret SSOT off this
# surface. INFISICAL_CLIENT_SECRET, INFISICAL_TOKEN and any AWS credential are
# PROHIBITED here (S1/S2).
#
# L9_CAPABILITY_BROKER_URL is deliberately ABSENT. The capability-broker
# experiment never shipped; every brokered capability stayed DEGRADED. Do not
# set this variable and do not paste a credential to work around authenticated
# sonar/semgrep/context7 being absent. Graphiti uses GRAPHITI_MCP_URL above.
INFISICAL_ENV=prod
INFISICAL_SITE_URL=https://app.infisical.com
INFISICAL_SECRET_PATH=/
