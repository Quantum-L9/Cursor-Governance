# L9_META
#   l9_schema: 1
#   repo: Quantum-L9/Cursor-Governance
#   path: environment/agents/adapters/generic/environment.env.example
#   layer: adapter-config
#   owner: governance-control-plane
#   status: active
#   version: 1.0.0
#   updated: 2026-07-31
#
# Generic template — copy into a NEW adapter directory and replace identity
# lines from agent_registry.yaml. Do NOT leave AGENT_ID placeholders in a
# dedicated adapter; validate_agents.py checks registry agreement.

# --- memory control plane (realignment stage C9) --------------------------
# Memory is the canonical l9-graphite-memory control plane (ops/memory),
# bound per checkout by ops/config/memory-binding.json. There is NO provider
# URL and NO memory bearer on this surface: the runtime resolves its own
# credentials (memory ADR-016). Pasting a bearer here is a contract violation
# (S3, §12). The capability-broker experiment never shipped.
# L9_MEMORY_INTERPRETER is optional: the Python carrying the pinned package.
# L9_MEMORY_INTERPRETER=

# Fill from registry (example shape — not a live agent):
# USER_ID=<agent_id_with_underscores>_agent
# L9_MEMORY_AGENT_ID=<agent_id>
# L9_MEMORY_SOURCE=<agent_id>
USER_ID=REPLACE_WITH_REGISTRY_USER_ID

L9_AGENT_ROLE=REPLACE_WITH_REGISTRY_ROLE
L9_GOVERNANCE_REPO=Quantum-L9/Cursor-Governance
L9_GOVERNANCE_DIR=$HOME/.cursor-governance
L9_MEMORY_AGENT_ID=REPLACE_WITH_REGISTRY_AGENT_ID
L9_MEMORY_SOURCE=REPLACE_WITH_REGISTRY_SOURCE

# --- Canonical secret bootstrap (shared by ALL agent surfaces) ----------------
# Bootstrap credentials ONLY. Every downstream token (SONAR_TOKEN,
# SEMGREP_APP_TOKEN, GITHUB_TOKEN, ...) is registered in ops/secrets and
# resolved at run time — never copied into an adapter env file.
#   bash ops/secrets/bootstrap_agent_env.sh --check --surface <this-surface>
# --- Canonical capability plane (retired) -------------------------------------
# NO CREDENTIALS BELONG IN THIS FILE. Infisical remains the secret SSOT off this
# surface. INFISICAL_CLIENT_SECRET, INFISICAL_TOKEN and any AWS credential are
# PROHIBITED here (S1/S2).
#
# L9_CAPABILITY_BROKER_URL is deliberately ABSENT. The capability-broker
# experiment never shipped; every brokered capability stayed DEGRADED. Do not
# set this variable and do not paste a credential to work around authenticated
# sonar/semgrep/context7 being absent. Memory is the bound control plane above.
INFISICAL_ENV=prod
INFISICAL_SITE_URL=https://app.infisical.com
INFISICAL_SECRET_PATH=/
