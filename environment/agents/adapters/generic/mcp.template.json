{
  "_comment": "Graphiti cloud front door — same store as Cursor tunnel.",
  "mcpServers": {
    "graphiti-memory": {
      "url": "${GRAPHITI_MCP_URL}",
      "headers": {
        "Authorization": "Bearer ${GRAPHITI_MCP_TOKEN}"
      },
      "timeout": 120000,
      "alwaysLoad": true
    }
  }
}
