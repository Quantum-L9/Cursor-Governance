# L9_META
#   path: environment/agents/adapters/codex/config.toml.example
#   layer: adapter-config
#   status: active
#   updated: 2026-07-31
#
# Merge into ~/.codex/config.toml (CLI) or paste equivalent MCP settings into
# the Codex cloud environment. Expand GRAPHITI_MCP_TOKEN from the account
# env — never commit a real bearer here.

[mcp_servers.graphiti-memory]
url = "${GRAPHITI_MCP_URL}"
http_headers = { "Authorization" = "Bearer ${GRAPHITI_MCP_TOKEN}", "X-L9-User-Id" = "codex_agent", "X-L9-Agent-Id" = "codex", "X-L9-Source" = "codex" }
