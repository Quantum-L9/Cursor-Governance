# Cursor adapter environment — identity + memory endpoint ONLY.
# NO CREDENTIAL VALUES in this file, ever. Transport credentials are ${VAR}
# references resolved by the platform/user environment, never written down.
# Identity SSOT: environment/agents/agent_registry.yaml (agents.cursor).

# --- identity trio (registry: agents.cursor) ---------------------------------
L9_MEMORY_AGENT_ID=cursor
USER_ID=cursor_agent
L9_GOVERNANCE_SURFACE=cursor

# --- memory front door --------------------------------------------------------
# Local Mac: SSH tunnel to the Graphiti MCP (ops/graphiti/); default port 8100.
GRAPHITI_MCP_URL=http://127.0.0.1:8100/mcp/

# --- optional, referenced not stored ------------------------------------------
# GRAPHITI_MCP_TOKEN is honored when the environment provides it
# (registry legacy_token_env). Do NOT paste a value here.
