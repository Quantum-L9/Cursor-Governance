#   version: 1.1.0
#   updated: 2026-07-31
#
# Gemini agent identity — RENDERED FROM agent_registry.yaml (agents.gemini).
# Never commit real secret values.

GRAPHITI_MCP_URL=https://memory.quantumaipartners.com/graphiti/mcp
# GRAPHITI_MCP_TOKEN is deliberately ABSENT. The bearer lives on the trusted
# side of the L9 capability broker; this surface reaches memory through the
# `graphiti.query` / `graphiti.write_governed` capabilities and never holds the
# credential. Pasting a bearer here is a contract violation (S3, §12).

USER_ID=gemini_agent

L9_AGENT_ROLE=reviewer
L9_GOVERNANCE_REPO=Quantum-L9/Cursor-Governance
L9_GOVERNANCE_DIR=$HOME/.cursor-governance
L9_MEMORY_AGENT_ID=gemini
L9_MEMORY_SOURCE=gemini

# --- Canonical secret bootstrap (shared by ALL agent surfaces) ----------------
# Bootstrap credentials ONLY. Every downstream token (SONAR_TOKEN,
# SEMGREP_APP_TOKEN, GITHUB_TOKEN, ...) is registered in ops/secrets and
# resolved at run time — never copied into an adapter env file.
#   bash ops/secrets/bootstrap_agent_env.sh --check --surface <this-surface>
# --- Canonical capability plane (ops/secrets) ---------------------------------
# NO CREDENTIALS BELONG IN THIS FILE. Infisical remains the secret SSOT, but a
# model-controlled surface never authenticates to it. INFISICAL_CLIENT_SECRET,
# INFISICAL_TOKEN and any AWS credential are PROHIBITED here (S1/S2).
#
# Point the surface at a trusted L9 capability broker instead. The broker holds
# a workload identity (Kubernetes Auth / SPIFFE / OIDC) mounted only into its
# own container, and returns capability results — never secret values.
#
# L9_CAPABILITY_BROKER_URL=https://broker.<your-l9-deployment>/l9/capability
#
# Leaving it unset is valid: capabilities report DEGRADED and the session runs
# without authenticated Sonar/Semgrep/Graphiti. That is better than pasting a
# credential to turn a check green.
INFISICAL_ENV=prod
INFISICAL_SITE_URL=https://app.infisical.com
INFISICAL_SECRET_PATH=/
