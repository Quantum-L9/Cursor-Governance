{
  "_l9_meta": {
    "l9_schema": 1,
    "repo": "Quantum-L9/Cursor-Governance",
    "path": "environment/agents/adapters/gemini/settings.template.json",
    "layer": "adapter-config",
    "owner": "governance-control-plane",
    "status": "active",
    "version": "1.1.0",
    "updated": "2026-07-31",
    "note": "Merge mcpServers into ~/.gemini/settings.json. $VARS expand from the environment; never hardcode tokens."
  },
  "mcpServers": {
    "graphiti-memory": {
      "httpUrl": "${GRAPHITI_MCP_URL}",
      "headers": {
        "Authorization": "Bearer $GRAPHITI_MCP_TOKEN",
        "X-L9-User-Id": "gemini_agent",
        "X-L9-Agent-Id": "gemini",
        "X-L9-Source": "gemini"
      },
      "timeout": 120000,
      "trust": false
    }
  }
}
