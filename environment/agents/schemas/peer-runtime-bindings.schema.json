{
  "$defs": {
    "autonomy": {
      "additionalProperties": false,
      "properties": {
        "provider_id": {
          "$ref": "#/$defs/kebabId"
        },
        "required": {
          "const": true,
          "type": "boolean"
        }
      },
      "required": [
        "required",
        "provider_id"
      ],
      "type": "object"
    },
    "binding": {
      "additionalProperties": false,
      "properties": {
        "execution_profile_ref": {
          "$ref": "#/$defs/kebabId"
        },
        "provider_ref": {
          "$ref": "#/$defs/kebabId"
        },
        "surface": {
          "$ref": "#/$defs/nonEmpty"
        }
      },
      "required": [
        "surface",
        "provider_ref",
        "execution_profile_ref"
      ],
      "type": "object"
    },
    "deployment": {
      "additionalProperties": false,
      "properties": {
        "readiness_required": {
          "type": "boolean"
        }
      },
      "required": [
        "readiness_required"
      ],
      "type": "object"
    },
    "execution": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "required": {
                "const": true
              }
            },
            "required": [
              "required"
            ]
          },
          "then": {
            "properties": {
              "bindings": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "properties": {
        "bindings": {
          "items": {
            "$ref": "#/$defs/binding"
          },
          "type": "array",
          "uniqueItems": true
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "required",
        "bindings"
      ],
      "type": "object"
    },
    "generated_data": {
      "additionalProperties": false,
      "properties": {
        "capture_readiness_required": {
          "type": "boolean"
        },
        "required": {
          "type": "boolean"
        }
      },
      "required": [
        "required",
        "capture_readiness_required"
      ],
      "type": "object"
    },
    "kebabId": {
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
      "type": "string"
    },
    "nonEmpty": {
      "minLength": 1,
      "type": "string"
    },
    "peer": {
      "additionalProperties": false,
      "properties": {
        "agent_ref": {
          "$ref": "#/$defs/kebabId"
        },
        "autonomy": {
          "$ref": "#/$defs/autonomy"
        },
        "execution": {
          "$ref": "#/$defs/execution"
        },
        "generated_data": {
          "$ref": "#/$defs/generated_data"
        },
        "results": {
          "$ref": "#/$defs/results"
        },
        "subagents": {
          "$ref": "#/$defs/subagents"
        }
      },
      "required": [
        "agent_ref",
        "execution",
        "autonomy",
        "subagents",
        "results",
        "generated_data"
      ],
      "type": "object"
    },
    "results": {
      "additionalProperties": false,
      "properties": {
        "readiness_required": {
          "type": "boolean"
        }
      },
      "required": [
        "readiness_required"
      ],
      "type": "object"
    },
    "subagents": {
      "additionalProperties": false,
      "properties": {
        "deployment": {
          "$ref": "#/$defs/deployment"
        },
        "enabled": {
          "type": "boolean"
        },
        "roles_manifest": {
          "$ref": "#/$defs/nonEmpty"
        }
      },
      "required": [
        "enabled"
      ],
      "type": "object"
    }
  },
  "$id": "https://quantum-l9.dev/schemas/peer-runtime-bindings.v3.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Sole topology SSOT for peer, provider, execution-profile, and canonical root-autonomy bindings.",
  "properties": {
    "peers": {
      "additionalProperties": false,
      "minProperties": 1,
      "patternProperties": {
        "^[a-z][a-z0-9]*(-[a-z0-9]+)*$": {
          "$ref": "#/$defs/peer"
        }
      },
      "type": "object"
    },
    "schema": {
      "const": "l9.peer-runtime-bindings.v3"
    },
    "schema_version": {
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "schema_version",
    "peers"
  ],
  "title": "L9 Peer Runtime Bindings",
  "type": "object"
}
