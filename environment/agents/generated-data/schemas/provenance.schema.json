{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-l9.dev/schemas/subagent-generated-data/provenance.schema.json",
  "title": "L9 Generated Data Provenance",
  "description": "Shared provenance contract (law §10.2, §12). Referenced by the subagent data packet and every generated data unit so evidence is traced identically wherever it appears.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "evidenceRef": {
      "title": "Evidence reference",
      "description": "One inspectable evidence reference (law §10.2). Identifies the source (source_id, source_type) and, where applicable, the repository/path/commit/locator that make it re-inspectable.",
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_type"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "source_type": {
          "type": "string",
          "enum": [
            "repository_path",
            "file_hash",
            "commit",
            "test_result",
            "command_receipt",
            "typed_artifact",
            "runtime_probe",
            "ci_result",
            "review_finding",
            "governed_external_source"
          ]
        },
        "repository": {"type": "string", "minLength": 1},
        "repository_class": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "base_sha": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1},
        "url": {"type": "string", "minLength": 1},
        "test_id": {"type": "string", "minLength": 1},
        "command": {"type": "string", "minLength": 1},
        "ci_id": {"type": "string", "minLength": 1},
        "review_id": {"type": "string", "minLength": 1},
        "description": {"type": "string"}
      }
    },
    "provenanceBlock": {
      "title": "Provenance block",
      "description": "Aggregate provenance for a packet: what repository state produced it, what was consumed, what evidence was produced, what was inspected, and what was executed.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "repository_class": {"type": "string", "minLength": 1},
        "base_sha": {"type": "string", "minLength": 1},
        "input_artifacts": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "default": []
        },
        "evidence_artifacts": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "default": []
        },
        "inspected_paths": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "default": []
        },
        "executed_commands": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "default": []
        },
        "generated_at": {"type": "string", "minLength": 1}
      }
    }
  },
  "properties": {
    "repository": {"type": "string", "minLength": 1},
    "repository_class": {"type": "string", "minLength": 1},
    "base_sha": {"type": "string", "minLength": 1},
    "input_artifacts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "evidence_artifacts": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "inspected_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "executed_commands": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "default": []
    },
    "generated_at": {"type": "string", "minLength": 1}
  }
}
