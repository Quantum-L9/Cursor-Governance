{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-l9.dev/schemas/cursor-subagents/cursor-subagent-result.schema.json",
  "title": "L9 Cursor Subagent Result",
  "description": "Structured result document returned by one bounded Cursor subagent action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "result_id",
    "result_kind",
    "status",
    "identity",
    "assignment",
    "deliverable",
    "provenance"
  ],
  "$defs": {
    "role": {
      "type": "string",
      "enum": [
        "recon",
        "pr_remediation",
        "test",
        "documentation",
        "verifier_reviewer"
      ]
    },
    "resultKind": {
      "type": "string",
      "enum": [
        "ReconReport",
        "PRRemediationReport",
        "TestReport",
        "DocumentationReport",
        "VerificationReviewReport"
      ]
    },
    "generatedDataClass": {
      "type": "string",
      "enum": [
        "repository_fact",
        "architecture_boundary",
        "ownership_finding",
        "dependency_finding",
        "implementation_surface",
        "execution_procedure",
        "validation_procedure",
        "failure_pattern",
        "rejected_approach",
        "context_requirement",
        "context_waste",
        "task_contract_gap",
        "policy_candidate",
        "invariant_candidate",
        "regression_candidate",
        "reusable_pattern_candidate",
        "artifact_lineage",
        "unresolved_unknown",
        "follow_on_opportunity",
        "evidence_only"
      ]
    },
    "epistemicStatus": {
      "type": "string",
      "enum": [
        "observed",
        "derived",
        "hypothesized",
        "disproven",
        "contested",
        "unresolved"
      ]
    },
    "route": {
      "type": "string",
      "enum": [
        "memory",
        "contracts",
        "validation",
        "patterns",
        "architecture",
        "opportunities",
        "unknowns",
        "evidence",
        "reject"
      ]
    },
    "visibility": {
      "type": "string",
      "enum": [
        "campaign_local",
        "repository_local",
        "project_group",
        "constellation_internal",
        "restricted"
      ]
    },
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_type"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "enum": [
            "repository_path",
            "file_hash",
            "commit",
            "test_result",
            "command_receipt",
            "typed_artifact",
            "runtime_probe",
            "review_finding",
            "governed_external_source"
          ]
        },
        "repository": {
          "type": "string",
          "minLength": 1
        },
        "repository_class": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "commit": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "minLength": 1
        },
        "test_id": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "review_id": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        }
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "primary_class",
        "epistemic_status",
        "statement",
        "scope",
        "confidence"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "primary_class": {
          "$ref": "#/$defs/generatedDataClass"
        },
        "secondary_tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "default": []
        },
        "epistemic_status": {
          "$ref": "#/$defs/epistemicStatus"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": true
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "default": []
        },
        "proposed_routes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/route"
          },
          "default": []
        },
        "expected_reuse": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "task_local": {
              "type": "boolean"
            },
            "cross_task": {
              "type": "boolean"
            },
            "cross_campaign": {
              "type": "boolean"
            },
            "cross_repository": {
              "type": "boolean"
            },
            "description": {
              "type": "string"
            }
          }
        },
        "invalidation_conditions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "condition_type"
            ],
            "properties": {
              "condition_type": {
                "type": "string",
                "enum": [
                  "relevant_path_changed",
                  "repository_base_changed",
                  "schema_version_changed",
                  "contract_version_changed",
                  "policy_version_changed",
                  "architecture_owner_changed",
                  "dependency_upgraded",
                  "contradictory_evidence_accepted",
                  "failed_reuse_reported",
                  "expiration_reached"
                ]
              },
              "selector": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "default": []
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unknown_id",
        "description",
        "class",
        "blocking_status",
        "owner",
        "next_action",
        "evidence_needed",
        "source_action"
      ],
      "properties": {
        "unknown_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "class": {
          "type": "string",
          "enum": [
            "blocking",
            "validation",
            "harmless",
            "stale",
            "evidence_available_but_uninspected"
          ]
        },
        "blocking_status": {
          "type": "string",
          "enum": [
            "blocking",
            "non_blocking"
          ]
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "evidence_needed": {
          "type": "string",
          "minLength": 1
        },
        "source_action": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": "l9.cursor-subagent.result.v1"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "result_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "result_kind": {
      "$ref": "#/$defs/resultKind"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "partial",
        "blocked",
        "failed"
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "graph_id",
        "action_id",
        "agent_id",
        "lease_id",
        "base_sha"
      ],
      "properties": {
        "campaign_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "graph_id": {
          "type": "string",
          "minLength": 1
        },
        "action_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9._-]+$"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1
        },
        "lease_id": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-fA-F]{40}$"
        }
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "objective",
        "input_artifact_ids",
        "allowed_paths",
        "forbidden_paths"
      ],
      "properties": {
        "role": {
          "$ref": "#/$defs/role"
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "subject_agent_id": {
          "type": "string",
          "minLength": 1
        },
        "input_artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "allowed_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "forbidden_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "deliverable": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "findings",
        "files_read",
        "files_changed",
        "evidence",
        "commands_executed",
        "validations",
        "unresolved_items",
        "recommended_next_actions",
        "reuse_assessment",
        "visibility"
      ],
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "files_read": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "files_changed": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidenceRef"
          }
        },
        "commands_executed": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "exit_code"
            ],
            "properties": {
              "command": {
                "type": "string",
                "minLength": 1
              },
              "exit_code": {
                "type": "integer"
              },
              "result": {
                "type": "string"
              }
            }
          }
        },
        "validations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "validation_id",
              "method",
              "result"
            ],
            "properties": {
              "validation_id": {
                "type": "string",
                "minLength": 1
              },
              "method": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "type": "string",
                "enum": [
                  "PASS",
                  "FAIL",
                  "BLOCKED",
                  "NOT_RUN"
                ]
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "default": []
              }
            }
          }
        },
        "unresolved_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/unknown"
          }
        },
        "recommended_next_actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reuse_assessment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reusable_data_found",
            "confidence"
          ],
          "properties": {
            "reusable_data_found": {
              "type": "boolean"
            },
            "task_local_value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "cross_task_value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "cross_repository_value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "reason": {
              "type": "string"
            }
          }
        },
        "visibility": {
          "$ref": "#/$defs/visibility"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "produced_at"
      ],
      "properties": {
        "produced_at": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "oneOf": [
        {
          "properties": {
            "result_kind": {
              "const": "ReconReport"
            },
            "assignment": {
              "properties": {
                "role": {
                  "const": "recon"
                }
              }
            }
          }
        },
        {
          "properties": {
            "result_kind": {
              "const": "PRRemediationReport"
            },
            "assignment": {
              "properties": {
                "role": {
                  "const": "pr_remediation"
                }
              }
            }
          }
        },
        {
          "properties": {
            "result_kind": {
              "const": "TestReport"
            },
            "assignment": {
              "properties": {
                "role": {
                  "const": "test"
                }
              }
            }
          }
        },
        {
          "properties": {
            "result_kind": {
              "const": "DocumentationReport"
            },
            "assignment": {
              "properties": {
                "role": {
                  "const": "documentation"
                }
              }
            }
          }
        },
        {
          "properties": {
            "result_kind": {
              "const": "VerificationReviewReport"
            },
            "assignment": {
              "required": [
                "subject_agent_id"
              ],
              "properties": {
                "role": {
                  "const": "verifier_reviewer"
                }
              }
            }
          }
        }
      ]
    },
    {
      "if": {
        "properties": {
          "assignment": {
            "properties": {
              "role": {
                "enum": [
                  "recon",
                  "verifier_reviewer"
                ]
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "deliverable": {
            "properties": {
              "files_changed": {
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ]
}
