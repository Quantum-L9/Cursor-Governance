{
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "editor.formatOnSave": true,
  "search.exclude": {
    "**/.venv": true,
    "**/node_modules": true,
    "**/.ruff_cache": true,
    "**/__pycache__": true,
    "**/.cursor-commands": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/node_modules/**": true,
    "**/.ruff_cache/**": true,
    "**/__pycache__/**": true,
    "**/WIP/**": true,
    "**/current_work/**": true,
    "**/.cursor-commands/**": true
  }
}
