{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l9.program-execution.architecture-extractor-response.v1",
  "title": "Architecture semantic extractor response",
  "description": "Candidate interpretation only. Nothing here is authority until it is admitted against source provenance and grounding.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "items"],
  "properties": {
    "schema": { "const": "l9.program-execution.architecture-extractor-response.v1" },
    "request_id": { "type": "string" },
    "notes": { "type": "array", "items": { "type": "string" } },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "statement", "source_refs"],
      "properties": {
        "id": { "type": "string" },
        "kind": {
          "enum": [
            "objective",
            "requirement",
            "constraint",
            "prohibition",
            "decision",
            "assumption",
            "unknown",
            "risk",
            "scope_include",
            "scope_exclude",
            "evidence_requirement",
            "implementation_seam",
            "file_seam",
            "acceptance",
            "validation",
            "negative_case",
            "dependency",
            "ordering",
            "deferral",
            "informational"
          ]
        },
        "statement": { "type": "string", "minLength": 1 },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^SRC-[0-9]{4,}$" }
        },
        "materiality": { "enum": ["material", "informational"] },
        "confidence": { "enum": ["high", "medium", "low"] },
        "subject": { "type": "string" },
        "target": { "type": "string" },
        "rationale": { "type": "string" },
        "implementation_hint": { "type": "string" },
        "probeable": { "type": "boolean" },
        "suggested_paths": { "type": "array", "items": { "type": "string" } },
        "suggested_tests": { "type": "array", "items": { "type": "string" } },
        "related_semantic_ids": { "type": "array", "items": { "type": "string" } },
        "contradicts": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
