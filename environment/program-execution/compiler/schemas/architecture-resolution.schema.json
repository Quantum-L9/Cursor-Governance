{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l9.program-execution.architecture-resolution.v1",
  "title": "Architecture compilation resolution receipt",
  "description": "Immutable compiler artifact written under the primed cache before any campaign side effect. Proves what the semantic compilation saw, produced, rejected, and measured.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "source",
    "source_units",
    "semantic_items",
    "coverage",
    "extractor",
    "campaign_id"
  ],
  "properties": {
    "schema": {
      "const": "l9.program-execution.architecture-resolution.v1"
    },
    "campaign_id": { "type": "string", "minLength": 1 },
    "target": { "type": "string" },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["sha256", "media_type"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "media_type": { "type": "string" },
        "path": { "type": "string" }
      }
    },
    "source_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "line_start", "line_end", "sha256"],
        "properties": {
          "id": { "type": "string" },
          "line_start": { "type": "integer" },
          "line_end": { "type": "integer" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "kind": { "type": "string" },
          "signals": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "semantic_items": {
      "type": "array",
      "items": { "type": "object" }
    },
    "rejected_items": {
      "type": "array",
      "items": { "type": "object" }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "total_units",
        "classified_units",
        "material_units",
        "mapped_material_units",
        "unmapped_material_units",
        "status"
      ],
      "properties": {
        "status": { "enum": ["PASS", "FAIL"] }
      }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": true,
      "required": ["identity", "protocol"],
      "properties": {
        "identity": { "type": "string" },
        "protocol": { "type": "string" }
      }
    },
    "repair_rounds": { "type": "integer", "minimum": 0 },
    "repository_evidence": {
      "type": "array",
      "items": { "type": "object" }
    }
  }
}
