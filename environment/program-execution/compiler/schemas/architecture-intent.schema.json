{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l9.program-execution.architecture-intent.v1",
  "title": "Architecture Intent v1",
  "description": "Operator long-form architecture prose after deterministic normalization, hashing, and segmentation. This is not the raw document: it is the addressable record the compiler is allowed to reason about.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "target", "source", "units"],
  "properties": {
    "schema": { "const": "l9.program-execution.architecture-intent.v1" },
    "target": {
      "type": "string",
      "minLength": 3,
      "description": "owner/repo the architecture applies to"
    },
    "title": { "type": "string" },
    "declared": {
      "type": "boolean",
      "description": "true when the document itself carried the schema frontmatter; false when the operator selected the architecture route explicitly"
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["sha256", "media_type"],
      "properties": {
        "path": { "type": "string" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "media_type": { "type": "string", "minLength": 1 },
        "lines": { "type": "integer", "minimum": 1 }
      }
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/unit" }
    }
  },
  "$defs": {
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "line_start", "line_end", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^SRC-[0-9]{4,}$" },
        "kind": {
          "enum": [
            "frontmatter",
            "heading",
            "paragraph",
            "list_item",
            "table",
            "code_fence",
            "blockquote"
          ]
        },
        "line_start": { "type": "integer", "minimum": 1 },
        "line_end": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "signals": { "type": "array", "items": { "type": "string" } },
        "text": { "type": "string" }
      }
    }
  }
}
