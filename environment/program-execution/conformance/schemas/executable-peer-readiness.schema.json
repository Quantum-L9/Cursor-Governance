{
  "$id": "https://quantum-l9.dev/program-execution/executable-peer-readiness.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "title": "Executable Peer Readiness Receipt",
  "description": "The binding-level readiness receipt integrations/bootstrap/peer_readiness.py builds and probe_executable_peers.py writes. The writer validates against this schema before it returns a receipt.",
  "type": "object",
  "$defs": {
    "pass_fail": {
      "enum": ["PASS", "FAIL"]
    },
    "probe_status": {
      "enum": ["PASS", "FAIL", "BLOCKED", "UNSUPPORTED", "UNKNOWN"]
    },
    "identifier": {
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    }
  },
  "properties": {
    "schema": {
      "const": "l9.executable-peer-readiness.v3"
    },
    "agent_id": {
      "$ref": "#/$defs/identifier"
    },
    "surface": {
      "type": "string",
      "minLength": 1
    },
    "provider_ref": {
      "$ref": "#/$defs/identifier"
    },
    "execution_profile_ref": {
      "type": "string",
      "minLength": 1
    },
    "binding": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/pass_fail"
        },
        "error": {
          "type": ["string", "null"]
        },
        "autonomy_provider_ref": {
          "type": ["string", "null"]
        }
      },
      "required": ["status", "error", "autonomy_provider_ref"]
    },
    "program_execution": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/pass_fail"
        },
        "contract_family": {
          "type": ["string", "null"]
        },
        "descriptor_digest": {
          "type": ["string", "null"]
        },
        "provider_probe": {
          "additionalProperties": false,
          "type": "object",
          "properties": {
            "status": {
              "$ref": "#/$defs/probe_status"
            },
            "blocked_reason": {
              "type": ["string", "null"]
            },
            "capabilities": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "receipt_digest": {
              "type": ["string", "null"]
            }
          },
          "required": ["status", "blocked_reason", "capabilities", "receipt_digest"]
        }
      },
      "required": ["status", "contract_family", "descriptor_digest", "provider_probe"]
    },
    "autonomy": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/pass_fail"
        },
        "provider_id": {
          "type": ["string", "null"]
        },
        "protocol_version": {
          "type": ["string", "null"]
        },
        "canonical_path": {
          "type": ["string", "null"]
        },
        "gateway_enforced": {
          "type": "boolean"
        }
      },
      "required": [
        "status",
        "provider_id",
        "protocol_version",
        "canonical_path",
        "gateway_enforced"
      ]
    },
    "checks": {
      "additionalProperties": false,
      "type": "object",
      "properties": {
        "canonical_binding": {
          "$ref": "#/$defs/pass_fail"
        },
        "provider_conformance": {
          "$ref": "#/$defs/pass_fail"
        },
        "execution_profile": {
          "$ref": "#/$defs/pass_fail"
        },
        "provider_routable": {
          "$ref": "#/$defs/pass_fail"
        },
        "provider_probe": {
          "$ref": "#/$defs/probe_status"
        },
        "provider_probe_integrity": {
          "$ref": "#/$defs/pass_fail"
        },
        "autonomy_provider": {
          "$ref": "#/$defs/pass_fail"
        },
        "autonomy_conformance": {
          "$ref": "#/$defs/pass_fail"
        },
        "execution_gateway": {
          "$ref": "#/$defs/pass_fail"
        }
      },
      "required": [
        "canonical_binding",
        "provider_conformance",
        "execution_profile",
        "provider_routable",
        "provider_probe",
        "provider_probe_integrity",
        "autonomy_provider",
        "autonomy_conformance",
        "execution_gateway"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "enum": ["READY", "BLOCKED"]
    },
    "blocked_reason": {
      "type": ["string", "null"]
    },
    "receipt_digest": {
      "type": "string",
      "pattern": "^(sha256:)?[0-9a-f]{64}$"
    }
  },
  "required": [
    "schema",
    "agent_id",
    "surface",
    "provider_ref",
    "execution_profile_ref",
    "binding",
    "program_execution",
    "autonomy",
    "checks",
    "observed_at",
    "expires_at",
    "status",
    "blocked_reason",
    "receipt_digest"
  ]
}
