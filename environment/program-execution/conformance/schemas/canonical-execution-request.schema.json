{
  "$id": "l9.peer-execution.request.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "agent_ref": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "autonomy_authority": {
      "anyOf": [
        {
          "not": {
            "anyOf": [
              {
                "required": [
                  "rendered_contract"
                ]
              },
              {
                "required": [
                  "rendered_contract_digest"
                ]
              }
            ]
          },
          "properties": {
            "adapter_session_id": {
              "minLength": 1,
              "type": "string"
            },
            "agent_id": {
              "minLength": 1,
              "type": "string"
            },
            "lease_id": {
              "minLength": 1,
              "type": "string"
            },
            "owns_program_state": {
              "const": false
            },
            "runtime_database": {
              "minLength": 1,
              "type": "string"
            },
            "schema": {
              "const": "l9.program-execution.autonomy-authority.v1"
            },
            "task_id": {
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "schema",
            "task_id",
            "adapter_session_id",
            "lease_id",
            "agent_id",
            "runtime_database",
            "owns_program_state"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "context_manifest_digest": {
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$",
      "type": "string"
    },
    "context_manifest_ref": {
      "minLength": 1,
      "type": "string"
    },
    "execution_id": {
      "minLength": 1,
      "type": "string"
    },
    "execution_profile_ref": {
      "minLength": 1,
      "type": "string"
    },
    "inference_budget": {
      "additionalProperties": false,
      "properties": {
        "max_turns": {
          "maximum": 64,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "max_turns"
      ],
      "type": "object"
    },
    "objective": {
      "minLength": 1,
      "type": "string"
    },
    "permission_profile": {
      "type": "object"
    },
    "permission_profile_ref": {
      "minLength": 1,
      "type": "string"
    },
    "program_lock_digest": {
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$",
      "type": "string"
    },
    "provider_ref": {
      "minLength": 1,
      "type": "string"
    },
    "rendered_contract": {
      "type": "object"
    },
    "rendered_contract_digest": {
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$",
      "type": "string"
    },
    "requested_capabilities": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "schema": {
      "const": "l9.peer-execution.request.v1"
    },
    "surface": {
      "anyOf": [
        {
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    },
    "telemetry_context": {
      "type": "object"
    },
    "timeout_budget": {
      "additionalProperties": false,
      "properties": {
        "dispatch_seconds": {
          "maximum": 7200,
          "minimum": 1,
          "type": "integer"
        },
        "poll_seconds": {
          "maximum": 600,
          "minimum": 1,
          "type": "integer"
        }
      },
      "required": [
        "dispatch_seconds",
        "poll_seconds"
      ],
      "type": "object"
    },
    "worker_instruction": {
      "minLength": 1,
      "type": "string"
    },
    "worktree_ref": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema",
    "execution_id",
    "task_id",
    "program_lock_digest",
    "rendered_contract_digest",
    "worktree_ref",
    "objective",
    "context_manifest_ref",
    "permission_profile_ref",
    "permission_profile",
    "inference_budget",
    "timeout_budget",
    "requested_capabilities",
    "telemetry_context",
    "agent_ref",
    "surface",
    "provider_ref",
    "execution_profile_ref",
    "context_manifest_digest",
    "rendered_contract",
    "worker_instruction"
  ],
  "type": "object"
}
