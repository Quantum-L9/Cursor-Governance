{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-execution-blueprint.phase0-user-config.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "phase",
    "definition_status",
    "program_deploying",
    "autonomy",
    "adapter_status",
    "blocking_inventory",
    "stop_conditions_reviewed",
    "approvals_preauthorized",
    "open_business_decisions",
    "alignment",
    "campaign_authorization_packet",
    "kill_switch",
    "resource_hygiene_ack",
    "operator_ack",
    "completeness"
  ],
  "properties": {
    "schema": {
      "const": "program-execution-blueprint.phase0-user-config.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "phase": {
      "const": 0
    },
    "definition_status": {
      "enum": ["draft", "active", "superseded", "retired"]
    },
    "program_deploying": {
      "type": "boolean"
    },
    "autonomy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default",
        "profile",
        "authority",
        "autonomous_merge",
        "max_parallel_workers",
        "max_mutation_lanes",
        "remediation_skill"
      ],
      "properties": {
        "default": {
          "enum": ["maximum_within_ceiling", "narrowed_by_decision"]
        },
        "profile": {
          "enum": ["bounded_local_execution", "program_deploy_max_autonomy"]
        },
        "authority": {
          "type": "string",
          "minLength": 1
        },
        "autonomous_merge": {
          "const": false
        },
        "max_parallel_workers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4
        },
        "max_mutation_lanes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "remediation_skill": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "adapter_status": {
      "enum": ["absent", "present"]
    },
    "blocking_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["true_blocking", "advisory_or_disabled"],
      "properties": {
        "true_blocking": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "advisory_or_disabled": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stop_conditions_reviewed": {
      "type": "boolean"
    },
    "approvals_preauthorized": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "expiry", "bound_to_program_digest"],
        "properties": {
          "action": {
            "enum": ["push", "pull_request", "commit", "local_write"]
          },
          "expiry": { "type": "string", "minLength": 1 },
          "bound_to_program_digest": { "const": true }
        }
      }
    },
    "open_business_decisions": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "alignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "uv_lock_check",
        "toolchain_pin_lockstep",
        "make_pr_gate_required",
        "targets_inventoried"
      ],
      "properties": {
        "uv_lock_check": {
          "enum": ["pending", "pass", "fail", "not_applicable"]
        },
        "toolchain_pin_lockstep": {
          "enum": ["pending", "pass", "fail", "not_applicable"]
        },
        "make_pr_gate_required": { "const": true },
        "targets_inventoried": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "campaign_authorization_packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_id",
        "declared_repos",
        "declared_prs",
        "declared_branches",
        "declared_ops"
      ],
      "properties": {
        "packet_id": {
          "type": ["string", "null"]
        },
        "declared_repos": {
          "type": "array",
          "items": { "type": "string" }
        },
        "declared_prs": {
          "type": "array",
          "items": { "type": ["string", "integer"] }
        },
        "declared_branches": {
          "type": "array",
          "items": { "type": "string" }
        },
        "declared_ops": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "kill_switch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "operator_action", "auto_file_watch_enforced"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "operator_action": { "type": "string", "minLength": 1 },
        "auto_file_watch_enforced": { "type": "boolean" }
      }
    },
    "resource_hygiene_ack": {
      "type": "boolean"
    },
    "operator_ack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "acknowledged_at"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "acknowledged_at": {
          "type": ["string", "null"]
        }
      }
    },
    "completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["phase0_complete"],
      "properties": {
        "phase0_complete": { "type": "boolean" }
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
