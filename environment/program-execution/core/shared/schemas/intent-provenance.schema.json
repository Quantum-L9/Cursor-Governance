{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l9.program-execution.intent-provenance.v1",
  "title": "Intent provenance carried inside a generated campaign-source.v2",
  "description": "Proves the semantic mapping between an architecture-intent source and the campaign it compiled into: source digest, source-unit ledger, semantic items with source provenance and campaign mappings, and the machine-verified coverage result. The canonical campaign compiler revalidates all of it, so a hand-edited campaign source cannot silently bypass architecture coverage.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "source", "source_units", "semantic_items", "coverage", "extractor"],
  "properties": {
    "schema": {
      "const": "l9.program-execution.intent-provenance.v1"
    },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["sha256", "media_type"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "media_type": { "type": "string", "minLength": 1 },
        "path": { "type": "string" }
      }
    },
    "source_units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "line_start", "line_end", "sha256"],
        "properties": {
          "id": { "type": "string", "pattern": "^SRC-[0-9]{4,}$" },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "kind": { "type": "string" },
          "signals": { "type": "array", "items": { "type": "string" } },
          "materiality": { "enum": ["material", "informational", "routing_metadata"] }
        }
      }
    },
    "semantic_items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["id", "kind", "statement", "source_refs"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "minLength": 1 },
          "statement": { "type": "string", "minLength": 1 },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "materiality": { "enum": ["material", "informational"] },
          "campaign_mappings": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": ["kind", "id"],
              "properties": {
                "kind": {
                  "enum": [
                    "task",
                    "task_action",
                    "task_acceptance",
                    "task_validation",
                    "task_negative_case",
                    "task_path",
                    "prohibited_path",
                    "decision",
                    "risk",
                    "evidence_requirement",
                    "dependency_edge",
                    "wave",
                    "gate",
                    "scope_include",
                    "scope_exclude",
                    "program_objective"
                  ]
                },
                "id": { "type": "string", "minLength": 1 },
                "task_id": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "total_units",
        "classified_units",
        "material_units",
        "mapped_material_units",
        "unmapped_material_units",
        "status"
      ],
      "properties": {
        "total_units": { "type": "integer", "minimum": 1 },
        "classified_units": { "type": "integer", "minimum": 0 },
        "material_units": { "type": "integer", "minimum": 0 },
        "mapped_material_units": { "type": "integer", "minimum": 0 },
        "unmapped_material_units": { "type": "integer", "minimum": 0 },
        "status": { "enum": ["PASS", "FAIL"] }
      }
    },
    "extractor": {
      "type": "object",
      "additionalProperties": true,
      "required": ["identity", "protocol"],
      "properties": {
        "identity": { "type": "string", "minLength": 1 },
        "protocol": { "type": "string", "minLength": 1 }
      }
    },
    "repair_rounds": { "type": "integer", "minimum": 0 }
  }
}
