{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l9.program-execution.campaign-source.v2",
  "title": "Program Execution campaign source v2",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema",
    "schema_version",
    "metadata",
    "program"
  ],
  "properties": {
    "schema": {
      "const": "l9.program-execution.campaign-source.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "campaign_id",
        "title"
      ],
      "properties": {
        "campaign_id": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "operator_intake",
            "registered",
            "owner_converged",
            "withdrawn"
          ]
        },
        "source_is_immutable": {
          "type": "boolean"
        }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": true
    },
    "pipeline_contract": {
      "type": "object",
      "additionalProperties": true
    },
    "operator_directive": {
      "type": "object",
      "additionalProperties": true
    },
    "plan_status": {
      "type": "string",
      "enum": [
        "Ready",
        "ConditionallyReady",
        "Partial",
        "Blocked",
        "Failed"
      ]
    },
    "program": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "name",
        "definition_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "definition_status": {
          "type": "string",
          "minLength": 1
        },
        "contracts": {
          "type": "object",
          "additionalProperties": true
        }
      }
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "adapter": {
            "enum": [
              "git",
              "git_repo_adapter",
              "controller"
            ]
          },
          "repository_id": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "authorities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "id",
          "responsibility"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "responsibility": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string"
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "selected_option_id": {
            "type": ["string", "null"]
          },
          "blocking_task_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "blocking_task_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "likelihood": {
            "enum": [
              "possible",
              "likely",
              "unlikely",
              "high",
              "medium",
              "low",
              "UNKNOWN"
            ]
          }
        }
      }
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "predecessor_wave_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "consumers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "entrypoints": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "validation": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true
            }
          },
          "kernel_profile": {
            "type": "string",
            "enum": [
              "BUILD",
              "CHANGE",
              "AUDIT"
            ]
          },
          "nugget_id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "intent_provenance": {
      "type": "object",
      "additionalProperties": true,
      "description": "Architecture-intent lineage (l9.program-execution.intent-provenance.v1). Present only on campaign sources compiled from long-form architecture intent; validated and re-derived by compile_campaign_source.py rather than trusted.",
      "required": [
        "schema",
        "source",
        "source_units",
        "semantic_items",
        "coverage"
      ],
      "properties": {
        "schema": {
          "const": "l9.program-execution.intent-provenance.v1"
        },
        "campaign_id": {
          "type": "string"
        },
        "target": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "sha256"
          ],
          "properties": {
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "path": {
              "type": "string"
            },
            "media_type": {
              "type": "string"
            },
            "title": {
              "type": "string"
            }
          }
        },
        "extractor": {
          "type": "object",
          "additionalProperties": true
        },
        "source_units": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "sha256",
              "disposition"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^SRC-[0-9]{4,}$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "disposition": {
                "type": "string"
              },
              "line_start": {
                "type": "integer"
              },
              "line_end": {
                "type": "integer"
              }
            }
          }
        },
        "semantic_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": [
              "id",
              "kind",
              "statement",
              "source_refs"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^SEM-[0-9]{3,}$"
              },
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "pattern": "^SRC-[0-9]{4,}$"
                }
              },
              "campaign_mappings": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": true,
                  "required": [
                    "kind"
                  ]
                }
              }
            }
          }
        },
        "rejected_items": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "contradictions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        },
        "coverage": {
          "type": "object",
          "additionalProperties": true,
          "required": [
            "total_units",
            "material_units",
            "mapped_material_units",
            "unmapped_material_units",
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "PASS",
                "FAIL"
              ]
            },
            "total_units": {
              "type": "integer"
            },
            "material_units": {
              "type": "integer"
            },
            "mapped_material_units": {
              "type": "integer"
            },
            "unmapped_material_units": {
              "type": "integer"
            }
          }
        }
      }
    }
  }
}
