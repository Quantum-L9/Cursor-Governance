{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-execution-controller.gate-evaluation.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "evaluation_id",
    "gate_id",
    "program_digest",
    "gate_definition_digest",
    "result",
    "evidence_ids",
    "evaluated_by",
    "evaluated_at",
    "method",
    "waiver_id",
    "receipt_digest"
  ],
  "properties": {
    "schema": {
      "const": "program-execution-controller.gate-evaluation.v2"
    },
    "evaluation_id": {
      "type": "string",
      "minLength": 1
    },
    "gate_id": {
      "type": "string",
      "minLength": 1
    },
    "program_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "gate_definition_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNKNOWN",
        "NOT_APPLICABLE_WITH_REASON"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evaluated_by": {
      "type": "string",
      "minLength": 1
    },
    "evaluated_at": {
      "type": "string",
      "minLength": 1
    },
    "method": {
      "type": "string",
      "minLength": 1
    },
    "waiver_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "receipt_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
