{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-execution-blueprint.do-not-build.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "prohibited_primary_paths",
    "allowed_experiments"
  ],
  "properties": {
    "schema": {
      "const": "program-execution-blueprint.do-not-build.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "prohibited_primary_paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "path_or_pattern": {
            "type": "string",
            "description": "Repo path or glob. Present only when kind is `path`."
          },
          "reason": {
            "type": "string"
          },
          "detection": {
            "type": "string"
          },
          "exception_authority": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "path",
              "semantic"
            ],
            "description": "Which channel this prohibition travels in. `path` carries a repo path or glob and is matched by the Controller against the files an attempt changed; `semantic` carries an architecture law enforced by review and conformance. A semantic entry deliberately omits path_or_pattern: there is nothing to glob, and writing the law there made do_not_build report PASS having matched nothing."
          },
          "statement": {
            "type": "string",
            "description": "The prohibition as written, for both kinds."
          }
        }
      }
    },
    "allowed_experiments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "scope": {
            "type": "string"
          },
          "constraints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expiry": {
            "type": "string"
          }
        }
      }
    }
  }
}
