{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-execution-blueprint.source-traceability.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "authority_classes",
    "sources"
  ],
  "properties": {
    "schema": {
      "const": "program-execution-blueprint.source-traceability.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "authority_classes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "revision": {
            "type": "string"
          },
          "authority_class": {
            "type": "string"
          },
          "evidence_id": {
            "type": "string"
          },
          "claims": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "workstream_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "task_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gate_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string"
          }
        }
      }
    }
  }
}
