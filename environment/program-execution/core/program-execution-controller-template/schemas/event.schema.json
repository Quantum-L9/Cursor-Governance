{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-execution-controller.event.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sequence",
    "timestamp",
    "type",
    "actor",
    "payload",
    "previous_digest",
    "digest"
  ],
  "properties": {
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "timestamp": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "previous_digest": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
