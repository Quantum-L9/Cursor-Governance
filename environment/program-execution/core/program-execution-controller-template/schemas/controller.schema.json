{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-execution-controller.definition.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "controller"
  ],
  "properties": {
    "schema": {
      "const": "program-execution-controller.definition.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "owner",
        "version",
        "created_at",
        "definition_status",
        "artifact_type",
        "contracts",
        "autonomy_profile",
        "host_mode",
        "state",
        "invariants"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "const": "2.0.0"
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "definition_status": {
          "enum": [
            "template",
            "instantiated",
            "retired"
          ]
        },
        "artifact_type": {
          "const": "program_execution_controller"
        },
        "contracts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "controller",
            "blueprint",
            "pair"
          ],
          "properties": {
            "controller": {
              "const": "program-execution-controller.v2"
            },
            "blueprint": {
              "const": "program-execution-blueprint.v2"
            },
            "pair": {
              "const": "program-execution-system.v2"
            }
          }
        },
        "autonomy_profile": {
          "const": "bounded_local_execution"
        },
        "host_mode": {
          "const": "host_neutral"
        },
        "state": {
          "type": "object"
        },
        "invariants": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
