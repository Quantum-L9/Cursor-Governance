{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-execution-controller.source-contract.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "target_id",
    "repository_id",
    "objective",
    "requested_actions",
    "acceptance_obligation_ids",
    "writable_paths",
    "verification_mechanisms",
    "validation_commands",
    "required_gate_ids",
    "required_evidence_ids",
    "risk_tier",
    "remote_mutation",
    "stop_conditions",
    "rollback"
  ],
  "properties": {
    "schema": {
      "const": "program-execution-controller.source-contract.v2"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "requested_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inspect",
          "local_write",
          "commit",
          "push",
          "pull_request",
          "merge",
          "publish_or_release",
          "deploy_or_migrate",
          "destructive_change",
          "external_message"
        ]
      }
    },
    "acceptance_obligation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "writable_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_mechanisms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "method",
          "command_or_inspection",
          "environment",
          "expected_result"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "method": {
            "enum": [
              "command",
              "inspection",
              "command_and_inspection",
              "external_adapter"
            ]
          },
          "command_or_inspection": {
            "type": "string",
            "minLength": 1
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "expected_result": {
            "enum": [
              "PASS"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "validation_commands": {
      "type": "array",
      "minItems": 0,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Command-only projection of verification_mechanisms, in mechanism order. minItems is 0 on purpose, not by oversight: a task verified solely by external_adapter is terminal but is deliberately not shell-flattened, so it derives no commands. Requiring one here would refuse that legitimate shape. The non-vacuity guarantee lives elsewhere and is stronger: contracts.py binds this array equal to the command-method projection of verification_mechanisms, missing_terminal_verifier refuses a mutating task with no terminal verifier, and both the validation and worker_validation_claim gates report INCOMPLETE - never PASS - when this array is empty."
    },
    "required_gate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_tier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4"
      ]
    },
    "remote_mutation": {
      "const": "denied"
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback": {
      "type": "string",
      "minLength": 1,
      "not": {
        "pattern": "REPLACE_WITH"
      }
    }
  }
}
