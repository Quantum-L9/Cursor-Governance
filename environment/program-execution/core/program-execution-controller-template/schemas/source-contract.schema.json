{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-execution-controller.source-contract.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "task_id",
    "target_id",
    "repository_id",
    "objective",
    "requested_actions",
    "acceptance_obligation_ids",
    "writable_paths",
    "validation_commands",
    "required_gate_ids",
    "required_evidence_ids",
    "risk_tier",
    "remote_mutation",
    "stop_conditions",
    "rollback"
  ],
  "properties": {
    "schema": {
      "const": "program-execution-controller.source-contract.v2"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "requested_actions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inspect",
          "local_write",
          "commit",
          "push",
          "pull_request",
          "merge",
          "publish_or_release",
          "deploy_or_migrate",
          "destructive_change",
          "external_message"
        ]
      }
    },
    "acceptance_obligation_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "writable_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_commands": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_gate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "required_evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_tier": {
      "enum": [
        "T0",
        "T1",
        "T2",
        "T3",
        "T4"
      ]
    },
    "remote_mutation": {
      "const": "denied"
    },
    "stop_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "rollback": {
      "type": "string",
      "minLength": 1
    }
  }
}
