{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-execution-controller.approval.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "approval_id",
    "action",
    "task_id",
    "target_id",
    "repository_id",
    "program_digest",
    "base_sha",
    "candidate_sha",
    "permits",
    "forbids",
    "prerequisite_evidence_ids",
    "approved_by",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema": {
      "const": "program-execution-controller.approval.v2"
    },
    "approval_id": {
      "type": "string",
      "minLength": 1
    },
    "action": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "repository_id": {
      "type": "string",
      "minLength": 1
    },
    "program_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "candidate_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "permits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inspect",
          "local_write",
          "commit",
          "push",
          "pull_request",
          "merge",
          "publish_or_release",
          "deploy_or_migrate",
          "destructive_change",
          "external_message"
        ]
      }
    },
    "forbids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "inspect",
          "local_write",
          "commit",
          "push",
          "pull_request",
          "merge",
          "publish_or_release",
          "deploy_or_migrate",
          "destructive_change",
          "external_message"
        ]
      }
    },
    "prerequisite_evidence_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approved_by": {
      "type": "string",
      "minLength": 1
    },
    "issued_at": {
      "type": "string",
      "minLength": 1
    },
    "expires_at": {
      "type": "string",
      "minLength": 1
    }
  }
}
