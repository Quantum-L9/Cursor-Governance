        "strategic_authority_ref": {
          "type": "semantic_ref"
        }
      },
      "purpose": "Define the digest-bound candidate that bridges Plan Keeper reasoning and an authorized Strategic Plan revision. The candidate binds an exact predecessor, one exact proposed Strategic Plan Graph, and the exact reasoning episode that produced it. It is never Strategy merely because it exists and cannot admit, approve, or apply itself.\n",
      "required": [
