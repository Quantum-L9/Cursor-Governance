# ── Stateful Graphiti / runtime isolation ────────────────────────────────────
# Keep dynamic execution state out of the SSOT clone so guarded auto-sync stays
# fast-forward-clean and never collides with these per-machine/per-run files.
# NOTE: memory-bank/ (per-project scaffold) is ignored; ops/graphiti/memory-bank-template/
# is the tracked source and is intentionally NOT matched by this pattern.
memory-bank/
.workflow_state_*.json
*.fallback.log
.cursor-globalcommands-fallback.log
.backup.*

*.pyc
__pycache__/

# ── Self-referential workspace wiring (SSOT repo is not its own "consumer" repo) ──
# setup_workspace_symlinks.sh can be run from inside ~/.cursor-governance itself,
# which creates a symlink pointing to itself plus a local .cursor/ dir. Harmless,
# but must never be committed — the SSOT clone is a source, not a consumer.
/.cursor-commands
/.cursor/
# .claude/{skills,rules} are managed mirrors generated by activation (see
# .claude/skills/.l9-managed-skills.json). The canonical skills/ and rules/
# source trees live at the clone root; these mirrors are machine-local.
.claude/skills/
.claude/skills
.claude/rules/
.claude/rules

# ── WIP/ is git-tracked human scratch; agents do not read or write it ──────
# Do NOT add a blanket `WIP/` gitignore — the tree stays commit-eligible.
# Agents are kept out via .cursorignore (`WIP/`) + rules/15-work-tracking.mdc.
# Scanners already exclude WIP/ via tool configs, not git.
# Only credential-shaped filenames under WIP are denylisted (2026-07-21: a
# session-end sync hook nearly staged a live Google OAuth client secret from
# WIP/google_oauth_*.json — caught before origin). Keep these patterns.
WIP/*oauth*.json
WIP/*credentials*.json
WIP/*client_secret*.json

# ── reports/ is local evidence only — never commit or track ─────────────────
# GMP receipts, audits, validation dumps. Pre-commit already excludes reports/;
# git must too so agents cannot stage them. Historical blobs may remain in git
# history; the working tree must stay untracked going forward.
reports/

# ── Bounded-autonomy durable state (per-consumer-workspace, never committed) ──
# environment/claude-code/autonomy/ writes campaign state, leases, and locks
# under L9_AUTONOMY_STATE_DIR (default .l9/autonomy/). It is machine-local
# runtime state, not source. The SessionStart probe is read-only, but init/run
# create this tree.
.l9/
# .l9/scratch-hold/ — non-WIP park vault (covered by .l9/ above; never park WIP/)
# L9 Subagent-Generated Data runtime
.l9/subagent-generated-data/*.sqlite3
.l9/subagent-generated-data/*.sqlite3-shm
.l9/subagent-generated-data/*.sqlite3-wal
environment/agents/generated-data/.runtime/

# ── Portable UI operator local residue (never commit profiles or live receipts) ──
ops/ui-operator/receipts/*.local.*
ops/ui-operator/receipts/local/
.l9-ui-profiles/

# ── WIP Legal Defense: media out, case work in (2026-08-13) ──
# Recordings/photos/WAV/frames/venv never commit. Ingest logs + transcripts do.
# Root `logs/` and `*.log` above would hide Evidence/logs — negate that tree.
WIP/Legal Defense/Evidence/originals/
WIP/Legal Defense/Evidence/working/
WIP/Legal Defense/Evidence/.venv/
WIP/Legal Defense/Evidence/derived/frames/
!WIP/Legal Defense/Evidence/logs/
!WIP/Legal Defense/Evidence/logs/**
!WIP/Legal Defense/Evidence/derived/
!WIP/Legal Defense/Evidence/derived/transcripts/
!WIP/Legal Defense/Evidence/derived/transcripts/**

# generated reports - CI artifacts, not source
governance-health-report.json
docs/rules-frontmatter-inventory.md
docs/skills-inventory.md

# runtime state
.harvest_executor_state.json
# .governance-build-lock stays tracked — session_start_bootstrap.sh reads it

# retired harvest dump — repo-hygiene fail-closes if this directory reappears
current_work/

