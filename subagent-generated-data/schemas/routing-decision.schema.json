{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-l9.dev/schemas/subagent-generated-data/routing-decision.schema.json",
  "title": "L9 Generated Data Routing Decision",
  "description": "Explicit routing and promotion decision for one generated data unit (law §15-§18).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "unit_id",
    "routes",
    "promotion_decision",
    "risk_class"
  ],
  "properties": {
    "unit_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$"},
    "primary_class": {"type": ["string", "null"]},
    "routes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "memory",
          "contracts",
          "validation",
          "patterns",
          "architecture",
          "opportunities",
          "unknowns",
          "evidence",
          "reject"
        ]
      }
    },
    "promotion_decision": {
      "type": "string",
      "enum": ["promote", "retain", "defer", "reject"]
    },
    "risk_class": {
      "type": "string",
      "enum": ["low", "medium", "high"]
    },
    "authority_required": {"type": ["string", "null"]},
    "authority_satisfied": {"type": "boolean", "default": false},
    "rejection_reason": {"type": ["string", "null"]},
    "blocking_conflict_ids": {
      "type": "array",
      "items": {"type": "string"},
      "default": []
    },
    "lineage": {
      "type": "array",
      "items": {"type": "string"},
      "default": [],
      "description": "unit_ids this decision supersedes, merges, or strengthens (dedup lineage, law §19)."
    },
    "decided_by": {"type": ["string", "null"]},
    "decided_at": {"type": ["string", "null"]}
  }
}
