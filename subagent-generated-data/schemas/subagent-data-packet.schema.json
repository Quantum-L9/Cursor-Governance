{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-l9.dev/schemas/subagent-generated-data/subagent-data-packet.schema.json",
  "title": "L9 Subagent Data Packet",
  "description": "Canonical typed envelope emitted by every completed subagent action (law §9).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "packet_id",
    "identity",
    "primary_result",
    "generated_data_units",
    "reuse_assessment",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"type": "string", "minLength": 1},
    "packet_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "campaign_id",
        "repository",
        "base_sha",
        "action_id",
        "agent_id",
        "role"
      ],
      "properties": {
        "campaign_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
        "graph_id": {"type": ["string", "null"]},
        "repository": {"type": "string", "minLength": 1},
        "repository_class": {"type": ["string", "null"]},
        "base_sha": {"type": "string", "minLength": 1},
        "action_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._-]+$"},
        "agent_id": {"type": "string", "minLength": 1},
        "role": {
          "type": "string",
          "enum": [
            "coordinator",
            "context",
            "recon",
            "synthesis",
            "executor",
            "verifier",
            "reviewer",
            "poller",
            "failure_classifier",
            "remediator",
            "sentinel",
            "evidence_writer"
          ]
        },
        "lease_id": {"type": ["string", "null"]}
      }
    },
    "primary_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_kind", "completion_status"],
      "properties": {
        "artifact_id": {"type": ["string", "null"]},
        "artifact_kind": {"type": "string", "minLength": 1},
        "completion_status": {
          "type": "string",
          "enum": ["completed", "failed", "partial", "blocked"]
        }
      }
    },
    "generated_data_units": {
      "type": "array",
      "items": {"$ref": "generated-data-unit.schema.json"},
      "default": []
    },
    "generated_data_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reusable_data_found"],
      "properties": {
        "reusable_data_found": {"type": "boolean"},
        "reason": {"type": ["string", "null"]}
      }
    },
    "unresolved_unknowns": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["unknown_id", "description", "class", "owner"],
        "properties": {
          "unknown_id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9._:-]+$"},
          "description": {"type": "string", "minLength": 1},
          "class": {
            "type": "string",
            "enum": [
              "blocking",
              "validation",
              "harmless",
              "stale",
              "evidence_available_but_uninspected"
            ]
          },
          "blocking_status": {
            "type": "string",
            "enum": ["blocking", "non_blocking"],
            "default": "non_blocking"
          },
          "owner": {"type": "string", "minLength": 1},
          "next_action": {"type": ["string", "null"]},
          "evidence_needed": {"type": ["string", "null"]},
          "source_action": {"type": ["string", "null"]}
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_artifacts": {"type": "array", "items": {"type": "string"}, "default": []},
        "evidence_artifacts": {"type": "array", "items": {"type": "string"}, "default": []},
        "inspected_paths": {"type": "array", "items": {"type": "string"}, "default": []},
        "executed_commands": {"type": "array", "items": {"type": "string"}, "default": []}
      }
    },
    "reuse_assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confidence"],
      "properties": {
        "task_local_value": {"type": ["string", "null"]},
        "cross_task_value": {"type": ["string", "null"]},
        "cross_repository_value": {"type": ["string", "null"]},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    },
    "visibility": {
      "type": "string",
      "enum": [
        "campaign_local",
        "repository_local",
        "project_group",
        "constellation_internal",
        "restricted"
      ],
      "default": "campaign_local"
    },
    "generated_at": {"type": "string", "minLength": 1}
  }
}
