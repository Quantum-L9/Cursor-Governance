{
  "$id": "l9.peer-execution.context-manifest.v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "base_sha": {
      "pattern": "^[0-9a-f]{40,64}$",
      "type": "string"
    },
    "manifest_digest": {
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$",
      "type": "string"
    },
    "program_lock_digest": {
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$",
      "type": "string"
    },
    "rendered_contract": {
      "type": "object"
    },
    "rendered_contract_digest": {
      "pattern": "^(?:sha256:)?[0-9a-f]{64}$",
      "type": "string"
    },
    "required_evidence_ids": {
      "items": {
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "schema": {
      "const": "l9.peer-execution.context-manifest.v1"
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    },
    "validation_commands": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "worker_instruction": {
      "minLength": 1,
      "type": "string"
    },
    "worktree": {
      "minLength": 1,
      "type": "string"
    },
    "writable_paths": {
      "items": {
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schema",
    "task_id",
    "program_lock_digest",
    "rendered_contract_digest",
    "base_sha",
    "worktree",
    "writable_paths",
    "validation_commands",
    "required_evidence_ids",
    "rendered_contract",
    "worker_instruction",
    "manifest_digest"
  ],
  "type": "object"
}
