{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l9.peer-execution.provider-result.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "execution_id",
    "status",
    "structured_payload",
    "raw_output_digest",
    "provider_metadata",
    "usage",
    "session_or_run_id",
    "observed_capabilities",
    "errors",
    "transport_evidence_refs"
  ],
  "properties": {
    "schema": {"const": "l9.peer-execution.provider-result.v1"},
    "execution_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "CANCELLED"]},
    "structured_payload": {"type": "object"},
    "raw_output_digest": {"type": ["string", "null"]},
    "provider_metadata": {"type": "object"},
    "usage": {"type": "object"},
    "session_or_run_id": {"type": ["string", "null"]},
    "observed_capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "errors": {"type": "array", "items": {"type": "object"}},
    "transport_evidence_refs": {
      "type": "array",
      "items": {"type": "object"}
    }
  }
}
