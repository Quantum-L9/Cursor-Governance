{"SDK_version":"2.0.0","advisory_findings":[{"canonical_rule_id":"L9-PY-SUBPROCESS-INJECTION","category":"security","finding_id":"fn_semgrep_56736f58662775b2525396243ea897b2cede429dbab96eaabc9ec6c669a77558","fingerprint":"7459c0a5f4e1bc76fbb3a3b92424ba9a9e43b417d80acf62ac6452e4d7e4c531","limitations":[],"locations":[{"end_column":14,"end_line":148,"normalized_path":"l9_ci/providers/semgrep/provider.py","start_column":25,"start_line":140}],"message":"Detected user input entering a `subprocess` call unsafely. This could result in a command injection vulnerability. An attacker could use this vulnerability to execute arbitrary commands on the host, which allows them to download malware, scan sensitive data, or run any command they wish on the server. Do not let users choose the command to run. In general, prefer to use Python API versions of system commands. If you must use subprocess, use a dictionary to allowlist a set of commands.","policy_key":"L9-PY-SUBPROCESS-INJECTION","provider_id":"semgrep","provider_rule_id":"python.django.security.injection.command.subprocess-injection.subprocess-injection","severity":"high"}],"autofix_candidates":[],"blocking_findings":[],"coverage":[{"files_analyzed":65,"files_considered":65,"limitations":[],"provider_id":"semgrep","status":"complete"}],"disabled_findings":[],"limitations":[],"provider_failures":[],"schema":"l9.agent-review-projection/v1","schema_version":"1.0.0","shadow_findings":[],"snapshot_id":"snap-audit-002","source_bundle_schema":"l9.finding-bundle/v1","source_bundle_schema_version":"1.0.0","summary":{"advisory_count":1,"autofix_candidate_count":0,"blocking_count":0,"disabled_count":0,"provider_failure_count":0,"shadow_count":0,"unresolved_count":0},"unresolved_findings":[]}
