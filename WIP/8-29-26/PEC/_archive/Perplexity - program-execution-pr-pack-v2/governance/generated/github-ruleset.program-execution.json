{
  "name": "program-execution",
  "target": "branch",
  "enforcement": "active",
  "conditions": { "ref_name": { "include": ["refs/heads/main"] } },
  "rules": [
    { "type": "required_status_checks", "parameters": { "required_status_checks": [{ "context": "agent-git-guard" }, { "context": "feature-tree-gate" }], "strict_required_status_checks_policy": true } },
    { "type": "pull_request", "parameters": { "required_approving_review_count": 1 } }
  ]
}
