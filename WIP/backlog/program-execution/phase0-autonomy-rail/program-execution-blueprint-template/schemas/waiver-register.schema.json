{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "program-execution-blueprint.waiver-register.v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "schema_version",
    "waivers",
    "policy"
  ],
  "properties": {
    "schema": {
      "const": "program-execution-blueprint.waiver-register.v2"
    },
    "schema_version": {
      "const": "2.0.0"
    },
    "waivers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "scope",
          "owner",
          "reason",
          "compensating_controls",
          "evidence_ids",
          "issued_at",
          "expires_at",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^WAIVER-[0-9]{3,}$"
          },
          "scope": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "compensating_controls": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "issued_at": {
            "type": "string",
            "minLength": 1
          },
          "expires_at": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "draft",
              "active",
              "expired",
              "revoked",
              "superseded"
            ]
          },
          "waiver_kind": {
            "enum": [
              "program_ci_advisory",
              "gate_obligation",
              "other"
            ]
          },
          "program_window": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "starts_at": { "type": "string", "minLength": 1 },
              "ends_at": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "implicit_waivers_forbidden",
        "expired_waiver_non_passing",
        "cosmetic_ci_disable_requires_phase0"
      ],
      "properties": {
        "implicit_waivers_forbidden": {
          "const": true
        },
        "expired_waiver_non_passing": {
          "const": true
        },
        "cosmetic_ci_disable_requires_phase0": {
          "const": true
        }
      }
    }
  }
}
