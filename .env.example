# ═══════════════════════════════════════════════════════════════════════════
# Cursor-Governance — repo-level environment flags
# ═══════════════════════════════════════════════════════════════════════════
#
# This file documents ONLY the behavior flags this repo's own scripts read
# directly from the process environment (confirmed via grep against
# ops/scripts/*.sh — not aspirational). It intentionally does NOT include:
#
#   - Memory provider connection/secret vars — there are none any more. Since
#     realignment stage C9/C11 (ADR-0030) memory is the canonical
#     l9-graphite-memory control plane over stdio (ops/memory); the runtime
#     resolves its own configuration. Binding: ops/config/memory-binding.json;
#     interpreter hint: L9_MEMORY_INTERPRETER (see the adapter env examples).
#
# None of the values below are secrets. Copy to .env and source it, or export
# directly -- no script in this repo currently auto-loads a root .env file.

# governance_sync.sh -- mirror origin/main exactly on next sync, discarding
# local divergence. Opt-in only; never set this as a persistent default.
GOVERNANCE_SYNC_HARD_RESET=0

# backup_to_github.sh -- skip the sessionEnd auto-backup for one session.
GOVERNANCE_BACKUP_SKIP=0

# backup_to_github.sh -- show what would be committed/pushed without doing it.
GOVERNANCE_BACKUP_DRY_RUN=0

# CANONICAL_LAW.md section 10 -- locks the production environment. Default
# false; do not flip in this repo without reading that section first.
GOVERNANCE_HARDENING_ENABLED=false

# CANONICAL_LAW.md section 10 / 8 -- Graphiti memory layer master switches.
# Memory switches read by the Cursor session hooks (ops/hooks/graphiti_common.sh).
# Canonical names; the legacy GRAPHITI_* names are honored as aliases.
L9_MEMORY_ENABLED=true
L9_MEMORY_WRITE_GATES=true

# ── GitHub agent authority (CANONICAL_LAW.md §14) ─────────────────────────
# NO second PAT. SSOT is AWS Secrets Manager — resolve, do not paste values.
# Ref (already provisioned): openclaw-igorbot/github#token
# Check: make secrets-check REF='openclaw-igorbot/github#token'
# Agents MUST export GH_TOKEN from that ref for gh/API work and MUST NOT ask
# the human to click github.com UI for App installs, permission accepts, or
# routine org/repo administration that the PAT can perform.
GITHUB_TOKEN_REF=openclaw-igorbot/github#token
# GH_TOKEN=   # never commit; resolve from AWS at runtime only

# ── Keys folded from retired .env.template (names only; no live values) ──
# Cloudflare identifiers — resolve values from AWS openclaw-igorbot/cloudflare.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_ZONE_NAME=
# CLOUDFLARE_AUTH_EMAIL=
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_GLOBAL_API_KEY=
# (No memory provider URL or token: see the note at the top of this file.)

