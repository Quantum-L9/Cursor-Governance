{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DPKAlertRunbook",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "alert"
  ],
  "properties": {
    "alert": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "severity",
        "owner",
        "signal",
        "condition",
        "runbook"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "page",
            "ticket",
            "warn"
          ]
        },
        "owner": {
          "type": "string"
        },
        "signal": {
          "type": "string"
        },
        "condition": {
          "type": "string"
        },
        "runbook": {
          "type": "string",
          "pattern": ".+\\.md$"
        },
        "dashboard": {
          "type": "string"
        },
        "rollback_candidate": {
          "type": "boolean"
        }
      }
    }
  }
}