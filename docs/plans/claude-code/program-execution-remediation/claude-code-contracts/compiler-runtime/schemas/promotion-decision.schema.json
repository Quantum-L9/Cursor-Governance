{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PromotionDecision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "subject",
    "risk_tier",
    "decision",
    "merge_meaning",
    "decision_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "subject": {
      "type": "object"
    },
    "risk_tier": {
      "type": "string",
      "enum": [
        "low",
        "standard",
        "high",
        "regulated"
      ]
    },
    "decision": {
      "type": "string",
      "enum": [
        "passed",
        "blocked"
      ]
    },
    "merge_meaning": {
      "type": "string",
      "enum": [
        "all_required_gates_passed",
        "required_gate_failed",
        "legacy_required_job_failed",
        "control_plane_failure"
      ]
    },
    "required": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "advisory": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "shadow": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "legacy_required": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "not_selected": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "missing_results": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unexpected_results": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "control_plane_errors": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}