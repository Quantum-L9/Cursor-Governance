{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DPKReadinessScore",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "total",
    "band",
    "categories",
    "red_line_triggered"
  ],
  "properties": {
    "total": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "band": {
      "type": "string",
      "enum": [
        "independently_operable",
        "conditionally_clear",
        "rejected"
      ]
    },
    "categories": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo_clarity",
        "arch_mapping",
        "local_reproducibility",
        "test_eval_coverage",
        "security_boundaries",
        "observability_integrity",
        "deploy_rollback",
        "transition_clarity"
      ],
      "properties": {
        "repo_clarity": {
          "type": "number",
          "minimum": 0
        },
        "arch_mapping": {
          "type": "number",
          "minimum": 0
        },
        "local_reproducibility": {
          "type": "number",
          "minimum": 0
        },
        "test_eval_coverage": {
          "type": "number",
          "minimum": 0
        },
        "security_boundaries": {
          "type": "number",
          "minimum": 0
        },
        "observability_integrity": {
          "type": "number",
          "minimum": 0
        },
        "deploy_rollback": {
          "type": "number",
          "minimum": 0
        },
        "transition_clarity": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "red_line_triggered": {
      "type": "boolean"
    },
    "red_line_reasons": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}