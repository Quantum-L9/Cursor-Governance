{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "identity",
    "subject",
    "policy",
    "outcome",
    "base_result",
    "content_hash"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "owner_layer",
        "mode"
      ],
      "properties": {
        "gate_id": {
          "type": "string"
        },
        "owner_layer": {
          "type": "string"
        },
        "mode": {
          "type": "string",
          "enum": [
            "blocking",
            "advisory",
            "shadow"
          ]
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "subject_sha",
        "base_sha",
        "event_type"
      ],
      "properties": {
        "repository": {
          "type": "string"
        },
        "subject_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "event_type": {
          "type": "string",
          "enum": [
            "pull_request",
            "merge_group",
            "push",
            "workflow_dispatch"
          ]
        }
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry_digest",
        "risk_policy_digest",
        "plan_digest"
      ],
      "properties": {
        "registry_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "risk_policy_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "rule_modes_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "error"
          ]
        },
        "violations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "metadata": {
          "type": "object"
        }
      }
    },
    "base_result": {
      "type": "object",
      "description": "PR-A / prerequisite base result retained BYTE-FOR-BYTE. Never mutated."
    },
    "content_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}