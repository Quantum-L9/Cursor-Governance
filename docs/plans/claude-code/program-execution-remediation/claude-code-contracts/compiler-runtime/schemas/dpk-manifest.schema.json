{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DPKManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "ownership",
    "boundaries",
    "interfaces"
  ],
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "type",
        "lifecycle",
        "criticality"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "lifecycle": {
          "type": "string",
          "enum": [
            "experimental",
            "beta",
            "production",
            "deprecated"
          ]
        },
        "criticality": {
          "type": "string",
          "enum": [
            "tier-1",
            "tier-2",
            "tier-3"
          ]
        },
        "description": {
          "type": "string"
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accountable_team",
        "operational_owner"
      ],
      "properties": {
        "accountable_team": {
          "type": "string"
        },
        "technical_owner": {
          "type": "string"
        },
        "operational_owner": {
          "type": "string"
        }
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "owns",
        "does_not_own"
      ],
      "properties": {
        "owns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "does_not_own": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "interfaces": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "inbound": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "outbound": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}