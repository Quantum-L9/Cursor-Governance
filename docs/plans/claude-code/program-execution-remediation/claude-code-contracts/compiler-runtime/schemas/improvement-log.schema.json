{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImprovementLogRow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pass_id",
    "change_id",
    "improvement_class",
    "target_artifact",
    "defect_or_gap",
    "action_taken",
    "evidence",
    "expected_gain",
    "regression_risk",
    "validation_status",
    "final_disposition"
  ],
  "properties": {
    "pass_id": {
      "type": "integer",
      "minimum": 1
    },
    "change_id": {
      "type": "string"
    },
    "improvement_class": {
      "type": "string",
      "enum": [
        "blocker_remediation",
        "correctness_improvement",
        "completeness_improvement",
        "validation_improvement",
        "operator_readiness_improvement",
        "maintainability_improvement",
        "leverage_improvement",
        "cosmetic_improvement"
      ]
    },
    "target_artifact": {
      "type": "string"
    },
    "defect_or_gap": {
      "type": "string"
    },
    "action_taken": {
      "type": "string"
    },
    "evidence": {
      "type": "string"
    },
    "expected_gain": {
      "type": "string"
    },
    "regression_risk": {
      "type": "string",
      "enum": [
        "none",
        "low",
        "medium",
        "high",
        "UNKNOWN"
      ]
    },
    "validation_status": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "final_disposition": {
      "type": "string",
      "enum": [
        "accepted",
        "rejected",
        "deferred",
        "mine_for_future"
      ]
    }
  }
}