# --- Secrets (AWS Secrets Manager — do NOT put values here) ----------------
# Cloudflare API credentials (Global API Key + limited API token, etc.):
#   SECRET_ID = openclaw-igorbot/cloudflare
#   JSON keys:
#     global_api_key  — Global API Key (use with X-Auth-Email + X-Auth-Key)
#     apitoken        — limited-scope API Token (Bearer; may be zone-scoped)
#     email           — same as CLOUDFLARE_AUTH_EMAIL above
#     accountid       — same as CLOUDFLARE_ACCOUNT_ID above
#     zone_id_quantumaipartners_com — same as CLOUDFLARE_ZONE_ID above
#
#   Fetch example:
#     aws secretsmanager get-secret-value \
#       --secret-id openclaw-igorbot/cloudflare \
#       --query SecretString --output text
