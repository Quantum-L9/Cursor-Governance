{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CampaignSpec",
  "description": "Canonical, hand-authored input for compile_contract.py. One spec is the single source of truth for a whole contract chain; JSON instances, CLAUDE.md, settings.json and preflight.sh are derived outputs. IDs, handoff seams, source_commits and chain_digest are NEVER authored here \u2014 the compiler derives them from item order.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign",
    "items"
  ],
  "properties": {
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id_prefix",
        "contract_version",
        "target_repo",
        "target_branch",
        "validation",
        "dpk"
      ],
      "properties": {
        "id_prefix": {
          "type": "string",
          "pattern": "^[A-Z0-9-]+$",
          "description": "Uppercase prefix. contract_id = <id_prefix>-PR-<key>-v<contract_version>."
        },
        "contract_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "target_repo": {
          "type": "string"
        },
        "target_branch": {
          "type": "string"
        },
        "base_prerequisite": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "required_state"
              ],
              "properties": {
                "id": {
                  "type": "string"
                },
                "required_state": {
                  "type": "string",
                  "enum": [
                    "merged_and_green",
                    "merged",
                    "present",
                    "committed_and_validated"
                  ]
                }
              }
            }
          ],
          "description": "What the FIRST item resumes from (e.g. the base scaffold PR). null if first item is greenfield."
        },
        "denied_tools": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "string"
          },
          "description": "Optional override. Defaults to the standard 6-pattern remote-mutation deny set."
        },
        "halt_boundary": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "git_push",
              "pr_open",
              "pr_merge",
              "required_check_change",
              "ruleset_change",
              "branch_protection_change",
              "merge_queue_activation",
              "ruleset_apply",
              "bypass_creation"
            ]
          }
        },
        "dpk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "manifest",
            "rollback_target"
          ],
          "properties": {
            "manifest": {
              "$ref": "dpk-manifest.schema.json"
            },
            "rollback_target": {
              "type": "string",
              "minLength": 1
            },
            "has_ai_feature": {
              "type": "boolean"
            },
            "evaluation_suite": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "cold_resume",
            "commit_gate"
          ],
          "description": "Explicit target-repository validation authority. The compiler projects these commands verbatim and MUST NOT infer an ecosystem or package manager.",
          "properties": {
            "cold_resume": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "commands"
              ],
              "properties": {
                "commands": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Target-native, non-interactive commands proving repository state is safe to resume. Setup/install commands are not implied."
                }
              }
            },
            "commit_gate": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "commands"
              ],
              "properties": {
                "commands": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "description": "Target-native commands that must pass before the current contract creates its one local commit."
                }
              }
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered same-branch chain. Item N depends on item N-1 committed_and_validated. Each item produces exactly one local commit; only the terminal item may run make pr.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key",
          "title",
          "allowed_files",
          "verify_proof",
          "sizing",
          "readiness"
        ],
        "properties": {
          "key": {
            "type": "string",
            "pattern": "^[A-Z0-9]+$",
            "description": "Short item key used in the contract_id (e.g. 002)."
          },
          "title": {
            "type": "string"
          },
          "allowed_files": {
            "type": "array",
            "minItems": 1,
            "description": "One entry per file the PR may create/modify -> becomes scope_lock.in_scope allowlist.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "deliverable",
                "path"
              ],
              "properties": {
                "deliverable": {
                  "type": "string"
                },
                "path": {
                  "type": "string"
                }
              }
            }
          },
          "forbidden_paths": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Concrete existing paths this PR must not change -> preserved_files (behavior_unchanged) unless overridden in 'preserved'."
          },
          "forbidden_capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Capabilities/features this PR must not implement -> hard_out_of_scope + must_not_add."
          },
          "preserved": {
            "type": "array",
            "description": "Explicit preserved-file guarantees; overrides the default for a forbidden_path.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "guarantee"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "guarantee": {
                  "type": "string",
                  "enum": [
                    "behavior_unchanged",
                    "comment_only",
                    "schema_compatible_only"
                  ]
                }
              }
            }
          },
          "verify_proof": {
            "type": "string",
            "minLength": 1,
            "description": "Runnable command proving THIS item executed in full and correctly. It is appended to this contract's required_before_commit gate and becomes the predecessor proof consumed by the next contract's preflight. Never prose."
          },
          "sizing": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "new_files",
              "modified_files",
              "test_cases",
              "commits"
            ],
            "properties": {
              "new_files": {
                "type": "integer",
                "minimum": 0
              },
              "modified_files": {
                "type": "integer",
                "minimum": 0
              },
              "test_cases": {
                "type": "integer",
                "minimum": 0
              },
              "commits": {
                "type": "integer",
                "const": 1,
                "description": "Exactly one local Git commit per contract. Multi-commit items must be decomposed into ordered contracts."
              },
              "matrix_cases": {
                "type": "integer",
                "minimum": 0
              }
            }
          },
          "readiness": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "categories"
            ],
            "description": "REAL DPK readiness assessment (required). No fabricated defaults.",
            "properties": {
              "categories": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "repo_clarity",
                  "arch_mapping",
                  "local_reproducibility",
                  "test_eval_coverage",
                  "security_boundaries",
                  "observability_integrity",
                  "deploy_rollback",
                  "transition_clarity"
                ],
                "properties": {
                  "repo_clarity": {
                    "type": "number",
                    "minimum": 0
                  },
                  "arch_mapping": {
                    "type": "number",
                    "minimum": 0
                  },
                  "local_reproducibility": {
                    "type": "number",
                    "minimum": 0
                  },
                  "test_eval_coverage": {
                    "type": "number",
                    "minimum": 0
                  },
                  "security_boundaries": {
                    "type": "number",
                    "minimum": 0
                  },
                  "observability_integrity": {
                    "type": "number",
                    "minimum": 0
                  },
                  "deploy_rollback": {
                    "type": "number",
                    "minimum": 0
                  },
                  "transition_clarity": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          },
          "not_applicable_sections": {
            "type": "object",
            "description": "Map of section-number(string) -> reason for sections marked not_applicable. Section 14 defaults to N/A when omitted.",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
