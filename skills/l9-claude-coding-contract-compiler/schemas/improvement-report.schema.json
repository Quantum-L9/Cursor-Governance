{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ImprovementReport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "improvement_objective",
    "baseline_state",
    "defects_targeted",
    "changes_made",
    "why_each_change_matters",
    "expected_effect",
    "validation_performed",
    "regression_check",
    "remaining_gaps",
    "next_best_action",
    "convergence_status"
  ],
  "properties": {
    "improvement_objective": {
      "type": "string",
      "minLength": 10
    },
    "baseline_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "lines",
        "known_defects",
        "scorecard"
      ],
      "properties": {
        "files": {
          "type": "integer"
        },
        "lines": {
          "type": "integer"
        },
        "known_defects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "scorecard": {
          "type": "object",
          "description": "10-dimension scorecard (0-5). UNKNOWN if unverifiable.",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "number",
                "minimum": 0,
                "maximum": 5
              },
              {
                "type": "string",
                "const": "UNKNOWN"
              }
            ]
          }
        }
      }
    },
    "defects_targeted": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "description",
          "priority_class"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "priority_class": {
            "type": "string",
            "enum": [
              "blocker_remediation",
              "correctness_improvement",
              "completeness_improvement",
              "validation_improvement",
              "operator_readiness_improvement",
              "maintainability_improvement",
              "leverage_improvement",
              "cosmetic_improvement"
            ]
          }
        }
      }
    },
    "changes_made": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "change_id",
          "target_artifact",
          "defect_id",
          "action",
          "improvement_class"
        ],
        "properties": {
          "change_id": {
            "type": "string"
          },
          "target_artifact": {
            "type": "string"
          },
          "defect_id": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "improvement_class": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "expected_gain": {
            "type": "string"
          }
        }
      }
    },
    "why_each_change_matters": {
      "type": "string",
      "minLength": 10
    },
    "expected_effect": {
      "type": "string"
    },
    "validation_performed": {
      "type": "string"
    },
    "regression_check": {
      "type": "string",
      "enum": [
        "PASS",
        "FAIL",
        "UNKNOWN",
        "NOT_APPLICABLE"
      ]
    },
    "remaining_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "next_best_action": {
      "type": "string"
    },
    "convergence_status": {
      "type": "string",
      "enum": [
        "IMPROVED_EXECUTION_READY",
        "IMPROVED_WITH_FINDINGS",
        "BLOCKED_ON_IMPROVEMENT",
        "REJECTED_CHANGE_SET",
        "MINE_FOR_FUTURE"
      ]
    }
  }
}
