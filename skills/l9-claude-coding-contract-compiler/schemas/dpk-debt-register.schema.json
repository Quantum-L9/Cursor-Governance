{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DPKDebtRegister",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "debt"
  ],
  "properties": {
    "debt": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "affected_paths",
          "target_state",
          "owner",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "origin": {
            "type": "string"
          },
          "affected_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "consequences": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "urgency_triggers": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "target_state": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "accepted",
              "in_progress",
              "resolved",
              "deferred"
            ]
          }
        }
      }
    }
  }
}
