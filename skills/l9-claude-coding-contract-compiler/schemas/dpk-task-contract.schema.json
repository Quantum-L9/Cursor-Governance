{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DPKTaskContract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task",
    "intent",
    "scope"
  ],
  "properties": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "type"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "behavior-change",
            "bugfix",
            "refactor",
            "feature",
            "migration"
          ]
        }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "problem",
        "desired_outcome"
      ],
      "properties": {
        "problem": {
          "type": "string"
        },
        "desired_outcome": {
          "type": "string"
        }
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed",
        "prohibited"
      ],
      "properties": {
        "allowed": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "prohibited": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "constraints": {
      "type": "object"
    }
  }
}
