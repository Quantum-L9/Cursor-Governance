{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ScopeLock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "in_scope",
    "hard_out_of_scope",
    "preserved_files"
  ],
  "properties": {
    "in_scope": {
      "type": "array",
      "minItems": 1,
      "description": "Ordered allowlist of deliverables. Files not here may not be created.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "deliverable"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "deliverable": {
            "type": "string"
          },
          "path": {
            "type": "string"
          }
        }
      }
    },
    "hard_out_of_scope": {
      "type": "array",
      "minItems": 1,
      "description": "Explicit forbidden implementations, named file by file.",
      "items": {
        "type": "string"
      }
    },
    "preserved_files": {
      "type": "array",
      "description": "Files whose behavior/commands must not change; comment-only edits allowed.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "guarantee"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "guarantee": {
            "type": "string",
            "enum": [
              "behavior_unchanged",
              "comment_only",
              "schema_compatible_only"
            ]
          }
        }
      }
    },
    "must_not_add": {
      "type": "array",
      "description": "Mirrors hard_out_of_scope for the required file manifest.",
      "items": {
        "type": "string"
      }
    }
  }
}
