{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://l9.local/schemas/plan-document.schema.json",
  "title": "PLAN_DOCUMENT",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "mode",
    "title",
    "objective",
    "success_criteria",
    "scope",
    "pre_validation",
    "todos",
    "critical_path",
    "milestones",
    "checkpoints",
    "doc_root_surface_impact",
    "stress_test",
    "leverage",
    "risks",
    "unknowns",
    "final_validation",
    "convergence",
    "gmp_handoff",
    "code_in_scope",
    "owner",
    "estimate",
    "execution_envelope",
    "complexity"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "plan",
        "spec",
        "ticket"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "success_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "in",
        "out"
      ],
      "properties": {
        "in": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "out": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        }
      }
    },
    "idea_execute_binding": {
      "description": "Optional binding used only when Idea Execute orchestrates a greenfield graph.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "gar_decision_ref",
        "gar_decision_digest",
        "gar_status",
        "graph_unit_ids",
        "lifecycle_run_id",
        "target"
      ],
      "properties": {
        "schema": {
          "const": "l9.idea-execute.plan-binding/v1"
        },
        "gar_decision_ref": {
          "type": "string",
          "minLength": 1
        },
        "gar_decision_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "gar_status": {
          "const": "ACCEPTED"
        },
        "graph_unit_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lifecycle_run_id": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "lifecycle",
            "logical_target_id",
            "future_repository_intent"
          ],
          "properties": {
            "lifecycle": {
              "const": "pre_birth_local_execution_workspace"
            },
            "logical_target_id": {
              "type": "string",
              "minLength": 1
            },
            "future_repository_intent": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "code_in_scope": {
      "type": "boolean"
    },
    "pre_validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command_or_action",
          "pass_criteria",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "command_or_action": {
            "type": "string"
          },
          "pass_criteria": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "passed",
              "failed",
              "skipped",
              "not_applicable",
              "unknown"
            ]
          }
        }
      }
    },
    "todos": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "task",
          "files",
          "effort",
          "risk",
          "dependencies",
          "leverage_rank",
          "layer"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "task": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "effort": {
            "type": "string"
          },
          "risk": {
            "enum": [
              "low",
              "medium",
              "high",
              "irreversible"
            ]
          },
          "dependencies": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "operation": {
            "enum": [
              "Insert",
              "Replace",
              "Delete",
              "Wrap",
              "Create"
            ]
          },
          "anchor": {
            "type": "string"
          },
          "blocker": {
            "type": "string"
          },
          "leverage_rank": {
            "type": "integer",
            "minimum": 1
          },
          "shared_root_cause": {
            "type": "string"
          },
          "layer": {
            "enum": [
              "control_plane",
              "data_plane",
              "chassis",
              "ops",
              "runtime",
              "policy",
              "assurance",
              "memory",
              "graph",
              "docs",
              "external_system"
            ],
            "description": "Architecture layer this todo touches; projected to the Architecture impact table."
          },
          "validation": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Terminal validation for this todo: single admissible shell commands (no pipes, chaining, redirection, -c/-e, or mutating git). Required for every todo that writes files when the plan is rendered as a Program Execution campaign-source.v2."
          },
          "acceptance": {
            "type": "string",
            "minLength": 1,
            "description": "Observable acceptance statement for this todo; projected to the campaign task's acceptance."
          }
        }
      }
    },
    "critical_path": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "milestones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "outcome",
          "unlocks"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "unlocks": {
            "type": "string"
          }
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "after",
          "evidence_required",
          "no_go_action"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "after": {
            "type": "string"
          },
          "evidence_required": {
            "type": "string"
          },
          "no_go_action": {
            "type": "string"
          }
        }
      }
    },
    "doc_root_surface_impact": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "surface",
          "action"
        ],
        "properties": {
          "surface": {
            "type": "string"
          },
          "action": {
            "enum": [
              "update",
              "n_a"
            ]
          },
          "todo_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          }
        }
      }
    },
    "stress_test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disconfirming_questions",
        "assumed_false_ifs",
        "blast_radius",
        "rollback"
      ],
      "properties": {
        "disconfirming_questions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "assumed_false_ifs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "blast_radius": {
          "type": "string",
          "minLength": 1
        },
        "rollback": {
          "type": "string"
        }
      }
    },
    "leverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ranked_todo_ids",
        "shared_causes",
        "deletions_or_consolidations"
      ],
      "properties": {
        "ranked_todo_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "shared_causes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deletions_or_consolidations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "risk",
          "mitigation"
        ],
        "properties": {
          "risk": {
            "type": "string"
          },
          "mitigation": {
            "type": "string"
          }
        }
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "decision_effect",
          "resolution"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "question": {
            "type": "string"
          },
          "decision_effect": {
            "type": "string"
          },
          "resolution": {
            "enum": [
              "ask",
              "probe",
              "block",
              "accept_bounded"
            ]
          }
        }
      }
    },
    "final_validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "command",
          "pass_criteria",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "command": {
            "type": "string"
          },
          "pass_criteria": {
            "type": "string"
          },
          "status": {
            "enum": [
              "pending",
              "passed",
              "failed",
              "skipped",
              "not_applicable",
              "unknown"
            ]
          }
        }
      }
    },
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "remaining_unknown_ids",
        "next_skill",
        "stop_reason"
      ],
      "properties": {
        "status": {
          "enum": [
            "converged",
            "partial",
            "blocked"
          ]
        },
        "remaining_unknown_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "next_skill": {
          "type": "string"
        },
        "stop_reason": {
          "type": "string"
        }
      }
    },
    "gmp_handoff": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_modify",
        "must_not_modify",
        "preserved_contracts",
        "validation_commands"
      ],
      "properties": {
        "may_modify": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_not_modify": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "preserved_contracts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "depth": {
      "enum": [
        "rapid",
        "standard",
        "deep"
      ]
    },
    "checklist": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "estimate": {
      "type": "string"
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "description": "Accountable human or actor ref (e.g. l9.actor-registry/global@1#claude-code); projected to metadata.owner."
    },
    "execution_envelope": {
      "type": "object",
      "additionalProperties": false,
      "description": "Network and secrets envelope projected to the Execution envelope section.",
      "required": [
        "network",
        "secrets"
      ],
      "properties": {
        "network": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "allowed_services"
          ],
          "properties": {
            "mode": {
              "enum": [
                "none",
                "read_only",
                "named_services_only",
                "existing_tunnel_only",
                "bounded_external_write"
              ]
            },
            "allowed_services": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "access"
          ],
          "properties": {
            "access": {
              "enum": [
                "none",
                "read_only_named",
                "runtime_injected_only"
              ]
            }
          }
        }
      }
    },
    "complexity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "architectural_boundaries_crossed",
        "external_systems_touched",
        "migration_required"
      ],
      "description": "Declared boundary, external-system and migration facts projected to Complexity and uncertainty. An empty list declares none.",
      "properties": {
        "architectural_boundaries_crossed": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "external_systems_touched": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "migration_required": {
          "type": "boolean"
        }
      }
    },
    "campaign": {
      "type": "object",
      "additionalProperties": false,
      "description": "Program Execution campaign binding, read by scripts/render_campaign_source.py when the plan is rendered as l9.program-execution.campaign-source.v2 for make campaign.",
      "properties": {
        "campaign_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,62}$"
        },
        "target_repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "source_of_truth": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
