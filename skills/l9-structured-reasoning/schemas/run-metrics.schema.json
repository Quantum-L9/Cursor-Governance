{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "fixture_id",
    "correctness",
    "evidence_fidelity",
    "option_quality",
    "actionability",
    "calibration",
    "token_count",
    "tool_calls",
    "unsupported_claims"
  ],
  "properties": {
    "fixture_id": {
      "type": "string",
      "minLength": 1
    },
    "correctness": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence_fidelity": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "option_quality": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "actionability": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "calibration": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "token_count": {
      "type": "integer",
      "minimum": 0
    },
    "tool_calls": {
      "type": "integer",
      "minimum": 0
    },
    "unsupported_claims": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
