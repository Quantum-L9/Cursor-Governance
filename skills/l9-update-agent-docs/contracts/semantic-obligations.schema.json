{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-l9.local/contracts/semantic-obligations.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "status", "required_surfaces", "obligations", "resolved_surfaces", "unresolved_surfaces", "blockers"],
  "properties": {
    "schema": {"const": "l9.repo-docs.semantic-obligations.v1"},
    "status": {"enum": ["PASS", "PARTIAL", "BLOCKED", "FAIL"]},
    "required_surfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "resolved_surfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "unresolved_surfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "obligations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["surface", "concept_id", "name", "action", "disposition", "semantic_contract", "problem", "risks", "acceptance_tests", "beneficiary_fit", "evidence", "rank_score"],
        "properties": {
          "surface": {"type": "string", "minLength": 1},
          "concept_id": {"type": "string", "minLength": 1},
          "name": {"type": "string"},
          "action": {"enum": ["ADD_OR_REFRESH", "HARDEN", "RECONCILE", "PRESERVE", "HANDOFF"]},
          "disposition": {"enum": ["PORT", "PORT_WITH_HARDENING", "MERGE_WITH_EXISTING", "CONFIGURE"]},
          "semantic_contract": {"type": ["string", "null"]},
          "problem": {"type": "string"},
          "risks": {"type": "array", "items": {"type": "string"}},
          "acceptance_tests": {"type": "array", "items": {"type": "object"}},
          "beneficiary_fit": {"type": ["object", "null"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "object"}},
          "rank_score": {"type": ["integer", "null"]}
        }
      }
    }
  }
}
