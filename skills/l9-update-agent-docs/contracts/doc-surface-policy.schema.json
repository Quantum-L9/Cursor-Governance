{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-l9.local/contracts/doc-surface-policy.schema.json",
  "title": "L9 Repository Documentation Surface Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "owner", "managed_regions", "surfaces", "impact_rules", "semantic_harvest", "capabilities", "llms_txt"],
  "properties": {
    "schema": {"const": "l9.repo-docs.surface-policy.v2"},
    "version": {"const": 2},
    "owner": {"type": "string", "minLength": 1},
    "managed_regions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blocks", "line_tokens"],
      "properties": {
        "blocks": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "start", "end"],
            "properties": {
              "id": {"type": "string"},
              "start": {"type": "string"},
              "end": {"type": "string"}
            }
          }
        },
        "line_tokens": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "token"],
            "properties": {
              "id": {"type": "string"},
              "token": {"type": "string"}
            }
          }
        }
      }
    },
    "surfaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["owner", "role", "authority_class", "requirement", "selectors", "create_policy", "refresh_policy", "generator", "evidence_sources", "prohibited_mutations", "llms_include"],
        "properties": {
          "owner": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "authority_class": {"enum": ["canonical_authority", "operating_ssot", "pointer", "index", "projection", "specialist", "external"]},
          "requirement": {"enum": ["required", "conditional", "optional", "external"]},
          "selectors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "create_policy": {"enum": ["never", "existing_only", "create_if_absent", "create_if_enabled", "generator_owned", "external_only"]},
          "refresh_policy": {"enum": ["never", "surgical", "surgical_additive", "pointer_only", "regenerate", "generator_owned", "external_only"]},
          "generator": {"type": ["string", "null"]},
          "evidence_sources": {"type": "array", "items": {"type": "string"}},
          "prohibited_mutations": {"type": "array", "items": {"type": "string"}},
          "llms_include": {"type": "boolean"}
        }
      }
    },
    "impact_rules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["patterns", "surfaces"],
        "properties": {
          "patterns": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "exclude_patterns": {"type": "array", "items": {"type": "string"}},
          "surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "semantic_harvest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "input_schema", "destinations", "activation", "accepted_dispositions", "confirmed_evidence_required"],
      "properties": {
        "owner": {"const": "l9-intelligence-harvest"},
        "input_schema": {"type": "string", "minLength": 1},
        "destinations": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "activation": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
        "accepted_dispositions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["PORT", "PORT_WITH_HARDENING", "MERGE_WITH_EXISTING", "CONFIGURE"]}},
        "confirmed_evidence_required": {"const": true}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_readmes"],
      "properties": {
        "module_readmes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "required_paths", "absence_behavior", "partial_behavior", "partial_repair_route", "polyglot_extension_owner", "supported_extensions"],
          "properties": {
            "owner": {"type": "string"},
            "required_paths": {
              "type": "object",
              "additionalProperties": false,
              "required": ["generator", "config", "dag"],
              "properties": {
                "generator": {"type": "string"},
                "config": {"type": "string"},
                "dag": {"type": "string"}
              }
            },
            "absence_behavior": {"enum": ["NotApplicable", "BLOCKED"]},
            "partial_behavior": {"enum": ["PARTIAL", "BLOCKED"]},
            "partial_repair_route": {"type": ["string", "null"]},
            "polyglot_extension_owner": {"type": "string"},
            "supported_extensions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        }
      }
    },
    "llms_txt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "spec_version", "published_surface_markers", "adapter_directive_block", "surface_order"],
      "properties": {
        "owner": {"type": "string"},
        "spec_version": {"type": "string"},
        "published_surface_markers": {"type": "array", "items": {"type": "string"}},
        "adapter_directive_block": {"type": "string"},
        "surface_order": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
