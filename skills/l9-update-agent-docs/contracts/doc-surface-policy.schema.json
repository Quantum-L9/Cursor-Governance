{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-l9.local/contracts/doc-surface-policy.schema.json",
  "title": "L9 Repository Documentation Surface Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "version", "owner", "managed_regions", "surfaces", "impact_rules", "semantic_harvest", "capabilities", "llms_txt"],
  "properties": {
    "schema": {"const": "l9.repo-docs.surface-policy.v2"},
    "version": {"const": 2},
    "owner": {"type": "string", "minLength": 1},
    "managed_regions": {"type": "object"},
    "surfaces": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["owner", "role", "authority_class", "requirement", "selectors", "create_policy", "refresh_policy", "generator", "evidence_sources", "prohibited_mutations", "llms_include"],
        "properties": {
          "owner": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "authority_class": {"enum": ["canonical_authority", "operating_ssot", "pointer", "index", "projection", "specialist", "external"]},
          "requirement": {"enum": ["required", "conditional", "optional", "external"]},
          "selectors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "create_policy": {"enum": ["never", "existing_only", "create_if_absent", "create_if_enabled", "generator_owned", "external_only"]},
          "refresh_policy": {"enum": ["never", "surgical", "surgical_additive", "pointer_only", "regenerate", "generator_owned", "external_only"]},
          "generator": {"type": ["string", "null"]},
          "evidence_sources": {"type": "array", "items": {"type": "string"}},
          "prohibited_mutations": {"type": "array", "items": {"type": "string"}},
          "llms_include": {"type": "boolean"}
        }
      }
    },
    "impact_rules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["patterns", "surfaces"],
        "properties": {
          "patterns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "exclude_patterns": {"type": "array", "items": {"type": "string"}},
          "surfaces": {"type": "array", "minItems": 1, "items": {"type": "string"}}
        }
      }
    },
    "semantic_harvest": {
      "type": "object",
      "required": ["owner", "input_schema", "destinations", "activation", "accepted_dispositions", "confirmed_evidence_required"],
      "properties": {
        "owner": {"const": "l9-intelligence-harvest"},
        "input_schema": {"type": "string", "minLength": 1},
        "destinations": {"type": "object", "additionalProperties": {"type": "string", "minLength": 1}},
        "activation": {"type": "object", "additionalProperties": {"type": "array", "minItems": 1, "items": {"type": "string"}}},
        "accepted_dispositions": {"type": "array", "items": {"enum": ["PORT", "PORT_WITH_HARDENING", "MERGE_WITH_EXISTING", "CONFIGURE"]}},
        "confirmed_evidence_required": {"const": true}
      }
    },
    "capabilities": {"type": "object"},
    "llms_txt": {"type": "object"}
  }
}
