{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quantum-l9.local/contracts/repo-docs-receipt.schema.json",
  "title": "L9 Repository Documentation Receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "final_status",
    "revision",
    "adapter",
    "changes",
    "impact",
    "consumer_snapshot",
    "architecture_delta",
    "adr_catalog",
    "surfaces",
    "obligations",
    "summary",
    "semantic_harvest",
    "capabilities",
    "llm_txt",
    "filetree",
    "validators_executed",
    "evidence_index",
    "structural_failures",
    "blockers"
  ],
  "properties": {
    "schema": {"const": "l9.repo-docs.receipt.v3"},
    "final_status": {"enum": ["PASS", "PARTIAL", "BLOCKED", "FAIL"]},
    "revision": {"$ref": "#/$defs/revision"},
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "resolution"],
      "properties": {
        "path": {"type": ["string", "null"]},
        "resolution": {"enum": ["EXPLICIT", "DISCOVERED", "NONE", "BLOCKED"]}
      }
    },
    "changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed_files", "run_mutations"],
      "properties": {
        "changed_files": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "run_mutations": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impacted_surfaces", "matched_rules"],
      "properties": {
        "impacted_surfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "matched_rules": {
          "type": "object",
          "additionalProperties": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
        }
      }
    },
    "consumer_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "revision", "changed_files", "surface_paths", "documents", "facts", "publication_markers", "authority_graph", "digest"],
      "properties": {
        "schema": {"const": "l9.repo-docs.consumer-snapshot.v1"},
        "revision": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tested_revision_sha"],
          "properties": {
            "repository": {"type": "string"},
            "tested_revision_sha": {"type": "string"}
          }
        },
        "changed_files": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "surface_paths": {"type": "object", "additionalProperties": {"type": "array", "items": {"type": "string"}}},
        "documents": {"type": "object", "additionalProperties": {"type": "object"}},
        "facts": {"type": "array", "items": {"type": "object"}},
        "publication_markers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "authority_graph": {"type": "object"},
        "digest": {"type": "string", "minLength": 64, "maxLength": 64}
      }
    },
    "architecture_delta": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["action", "kind", "path", "evidence_id"],
        "properties": {
          "action": {"enum": ["change", "unknown"]},
          "kind": {"type": "string"},
          "path": {"type": "string"},
          "evidence_id": {"type": "string"}
        }
      }
    },
    "adr_catalog": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "status", "conventions", "records", "findings", "enforcement", "digest"],
      "properties": {
        "schema": {"const": "l9.repo-docs.adr-catalog.v1"},
        "status": {"enum": ["PASS", "PARTIAL", "FAIL", "NotApplicable"]},
        "conventions": {"type": "object"},
        "records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "number", "title", "status", "date", "headings", "content_digest", "active", "validation"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "number": {"type": "string", "minLength": 3},
              "title": {"type": ["string", "null"]},
              "status": {"type": ["string", "null"]},
              "date": {"type": ["string", "null"]},
              "headings": {"type": "array", "items": {"type": "string"}},
              "content_digest": {"type": ["string", "null"]},
              "active": {"type": "boolean"},
              "validation": {
                "type": "object",
                "additionalProperties": false,
                "required": ["status", "findings"],
                "properties": {
                  "status": {"enum": ["PASS", "NEEDS_IMPROVEMENT", "BLOCKED"]},
                  "findings": {"type": "array", "items": {"$ref": "#/$defs/adrFinding"}}
                }
              }
            }
          }
        },
        "findings": {"type": "array", "items": {"$ref": "#/$defs/adrFinding"}},
        "enforcement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["active_paths", "historical_paths", "active_finding_count", "historical_finding_count"],
          "properties": {
            "active_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "historical_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "active_finding_count": {"type": "integer", "minimum": 0},
            "historical_finding_count": {"type": "integer", "minimum": 0}
          }
        },
        "digest": {"type": "string", "minLength": 64, "maxLength": 64}
      }
    },
    "surfaces": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "owner", "role", "authority_class", "requirement", "paths", "present", "action", "impacted"],
        "properties": {
          "id": {"type": "string"},
          "owner": {"type": "string"},
          "role": {"type": "string"},
          "authority_class": {"type": "string"},
          "requirement": {"type": "string"},
          "paths": {"type": "array", "items": {"type": "string"}},
          "present": {"type": "boolean"},
          "action": {"type": "string"},
          "impacted": {"type": "boolean"}
        }
      }
    },
    "obligations": {
      "type": "array",
      "items": {"$ref": "https://quantum-l9.local/contracts/documentation-obligation.schema.json"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total", "terminal", "open", "blocked", "awaiting_qualification", "by_status"],
      "properties": {
        "total": {"type": "integer", "minimum": 0},
        "terminal": {"type": "integer", "minimum": 0},
        "open": {"type": "integer", "minimum": 0},
        "blocked": {"type": "integer", "minimum": 0},
        "awaiting_qualification": {"type": "integer", "minimum": 0},
        "by_status": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
      }
    },
    "semantic_harvest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "status", "required_surfaces", "input", "discovered", "request", "semantic_source_digest", "source_paths", "blockers"],
      "properties": {
        "owner": {"type": "string", "minLength": 1},
        "status": {"enum": ["PASS", "PARTIAL", "BLOCKED", "FAIL", "NotApplicable"]},
        "required_surfaces": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "input": {"type": ["string", "null"]},
        "discovered": {"type": "boolean"},
        "request": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "properties": {
            "request_id": {"type": "string"},
            "donor": {"type": "string"},
            "beneficiary": {"type": "string"},
            "harvest_target": {"type": "string"},
            "access_mode": {"type": "string"},
            "depth": {"type": "string"},
            "brief": {"type": "boolean"}
          }
        },
        "semantic_source_digest": {"type": ["string", "null"]},
        "source_paths": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "blockers": {"type": "array", "items": {"type": "string"}}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_readmes"],
      "properties": {
        "module_readmes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "owner", "present", "partial_repair_route", "polyglot_extension_owner", "unsupported_impacted_extensions"],
          "properties": {
            "status": {"enum": ["AVAILABLE", "PARTIAL", "BLOCKED", "NotApplicable"]},
            "owner": {"type": "string"},
            "present": {"type": "object", "additionalProperties": {"type": "boolean"}},
            "partial_repair_route": {"type": ["string", "null"]},
            "polyglot_extension_owner": {"type": "string"},
            "unsupported_impacted_extensions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "planned": {
              "description": "README reconciliation histogram for this run. Diagnostic evidence attached to the capability, never a second obligation ledger.",
              "type": "object",
              "additionalProperties": false,
              "required": ["create", "refresh", "unchanged", "preserve", "retire", "conflict"],
              "properties": {
                "create": {"type": "integer", "minimum": 0},
                "refresh": {"type": "integer", "minimum": 0},
                "unchanged": {"type": "integer", "minimum": 0},
                "preserve": {"type": "integer", "minimum": 0},
                "retire": {"type": "integer", "minimum": 0},
                "conflict": {"type": "integer", "minimum": 0}
              }
            },
            "quality": {
              "description": "Deterministic source-evidence coverage per README target.",
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["path", "completeness", "eligible_source_count", "extracted_source_count", "extraction_issue_count", "relationship_count"],
                "properties": {
                  "path": {"type": "string"},
                  "completeness": {"enum": ["complete", "partial", "minimal-by-design"]},
                  "eligible_source_count": {"type": "integer", "minimum": 0},
                  "extracted_source_count": {"type": "integer", "minimum": 0},
                  "extraction_issue_count": {"type": "integer", "minimum": 0},
                  "relationship_count": {"type": "integer", "minimum": 0}
                }
              }
            }
          }
        }
      }
    },
    "llm_txt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "enabled", "enabled_reason", "base_url_source", "path", "written", "findings"],
      "properties": {
        "status": {"enum": ["PASS", "PARTIAL", "FAIL", "BLOCKED", "NotApplicable"]},
        "enabled": {"type": "boolean"},
        "enabled_reason": {"type": "string"},
        "base_url_source": {"type": "string"},
        "path": {"type": "string"},
        "written": {"type": "boolean"},
        "admission": {"enum": ["create", "refresh", "preserve", "unchanged", "skipped"]},
        "findings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "filetree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "path", "written", "module_count", "missing_readme_count", "findings"],
      "properties": {
        "status": {"enum": ["PASS", "PARTIAL", "FAIL", "BLOCKED", "NotApplicable"]},
        "path": {"const": "filetree.md"},
        "written": {"type": "boolean"},
        "admission": {"enum": ["create", "refresh", "preserve", "unchanged", "skipped"]},
        "module_count": {"type": "integer", "minimum": 0},
        "missing_readme_count": {"type": "integer", "minimum": 0},
        "findings": {"type": "array", "items": {"type": "string"}}
      }
    },
    "validators_executed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "findings"],
        "properties": {
          "name": {"type": "string"},
          "status": {"enum": ["PASS", "PARTIAL", "BLOCKED", "FAIL", "NotApplicable"]},
          "findings": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "evidence_index": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "structural_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "detail"],
        "properties": {
          "code": {"type": "string"},
          "severity": {"enum": ["FAIL", "BLOCKED"]},
          "detail": {"type": "string"}
        }
      }
    },
    "blockers": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
  },
  "$defs": {
    "adrFinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule_id", "severity", "property", "observed_state", "expected_state", "source", "line", "remediation_class"],
      "properties": {
        "rule_id": {"type": "string", "minLength": 1},
        "severity": {"enum": ["material", "blocking"]},
        "property": {"type": "string", "minLength": 1},
        "observed_state": {"type": "string"},
        "expected_state": {"type": "string"},
        "source": {"type": "string", "minLength": 1},
        "line": {"type": ["integer", "null"], "minimum": 1},
        "remediation_class": {"const": "HANDOFF"}
      }
    },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "base_ref", "base_sha", "source_head_sha", "tested_revision_sha", "comparison_mode"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "base_ref": {"type": ["string", "null"]},
        "base_sha": {"type": ["string", "null"]},
        "source_head_sha": {"type": "string", "minLength": 1},
        "tested_revision_sha": {"type": "string", "minLength": 1},
        "comparison_mode": {"enum": ["merge_base_to_head", "worktree_to_head", "snapshot", "unknown"]}
      }
    }
  }
}
