{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l9/dag-authoring/receipt-v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill", "version", "operation", "status", "checks", "changed_surfaces"],
  "properties": {
    "skill": {"const": "l9-dag-authoring"},
    "version": {"const": "2.0.0"},
    "operation": {"enum": ["CREATE", "UPDATE", "VALIDATE", "REGISTER", "COMMAND_BIND"]},
    "status": {"enum": ["PASS", "PARTIAL", "BLOCKED", "FAIL"]},
    "dag_id": {"type": ["string", "null"]},
    "checks": {"type": "array", "items": {"type": "object"}},
    "changed_surfaces": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
