{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l9/dag-authoring/receipt-v2.2",
  "type": "object",
  "additionalProperties": false,
  "required": ["skill", "version", "operation", "status", "checks", "changed_surfaces"],
  "properties": {
    "skill": {"const": "l9-dag-authoring"},
    "version": {"const": "2.2.0"},
    "operation": {
      "enum": ["CREATE", "UPDATE", "VALIDATE", "REGISTER", "COMMAND_BIND", "CONVERT"]
    },
    "status": {"enum": ["PASS", "PARTIAL", "BLOCKED", "FAIL"]},
    "dag_id": {"type": ["string", "null"]},
    "disposition": {
      "type": ["string", "null"],
      "enum": ["DELETE_TWIN", "ABSORB_INTO_SKILL", "CONVERT_TO_LANGGRAPH", null]
    },
    "target_skill": {"type": ["string", "null"]},
    "emitted_runtime": {"type": ["string", "null"]},
    "surviving_runtime": {"type": ["string", "null"]},
    "checks": {"type": "array", "items": {"type": "object"}},
    "changed_surfaces": {"type": "array", "items": {"type": "string"}},
    "unknowns": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  }
}
