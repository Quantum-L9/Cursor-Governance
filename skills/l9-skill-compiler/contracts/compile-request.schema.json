{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l9/skill-compiler/compile-request",
  "title": "CompileRequest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_id",
    "intent",
    "subject",
    "source_material",
    "target_profiles"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "intent": {
      "enum": [
        "create",
        "rebuild",
        "evolve",
        "validate",
        "compile"
      ]
    },
    "subject": {
      "type": "object",
      "required": [
        "proposed_name"
      ],
      "additionalProperties": false,
      "properties": {
        "proposed_name": {
          "type": "string"
        },
        "existing_skill": {
          "type": [
            "string",
            "null"
          ]
        },
        "domain": {
          "type": "string"
        },
        "stated_objective": {
          "type": "string"
        }
      }
    },
    "source_material": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "file",
              "dir",
              "prose",
              "transcript",
              "schema",
              "url"
            ]
          },
          "ref": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        }
      }
    },
    "target_profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "portable",
          "l9",
          "cursor",
          "claude_code",
          "openai"
        ]
      }
    },
    "constraints": {
      "type": "object"
    },
    "authority": {
      "type": "object",
      "properties": {
        "lease_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "autonomy_tier": {
          "type": [
            "string",
            "null"
          ]
        },
        "gateway": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
