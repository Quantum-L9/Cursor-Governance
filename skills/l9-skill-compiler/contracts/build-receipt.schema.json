{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l9/skill-compiler/build-receipt",
  "title": "BuildReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "request_identity",
    "topology_decision",
    "topology_evidence",
    "selected_profile",
    "traits",
    "source_evidence",
    "generated_artifacts",
    "static_validation_results",
    "capability_closure_result",
    "activation_eval_results",
    "behavior_eval_results",
    "package_result",
    "wiring_handoff_result",
    "unknowns",
    "failures",
    "exact_commands_or_tests_observed",
    "base_sha",
    "head_sha_if_created"
  ],
  "properties": {
    "request_identity": {
      "type": "string"
    },
    "topology_decision": {
      "enum": [
        "EXTEND_EXISTING",
        "COMPOSE_EXISTING",
        "REPLACE_EXISTING",
        "REJECT_NEW_SKILL",
        "CREATE_NEW"
      ]
    },
    "topology_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "selected_profile": {
      "type": "string"
    },
    "traits": {
      "type": "object"
    },
    "source_evidence": {
      "type": "array"
    },
    "generated_artifacts": {
      "type": "array"
    },
    "static_validation_results": {
      "type": "object"
    },
    "capability_closure_result": {
      "type": "object"
    },
    "activation_eval_results": {
      "type": "array"
    },
    "behavior_eval_results": {
      "type": "array"
    },
    "package_result": {
      "type": "object"
    },
    "wiring_handoff_result": {
      "type": "object"
    },
    "unknowns": {
      "type": "array"
    },
    "failures": {
      "type": "array"
    },
    "exact_commands_or_tests_observed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "exit_code"
        ],
        "properties": {
          "command": {
            "type": "string"
          },
          "exit_code": {
            "type": "integer"
          },
          "output_digest": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "base_sha": {
      "type": [
        "string",
        "null"
      ]
    },
    "head_sha_if_created": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
