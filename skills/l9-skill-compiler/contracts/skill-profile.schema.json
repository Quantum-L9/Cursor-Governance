{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l9/skill-compiler/skill-profile",
  "title": "SkillProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "primary_family",
    "traits",
    "evidence",
    "decided_by"
  ],
  "properties": {
    "primary_family": {
      "enum": [
        "advisory",
        "diagnostic",
        "operator",
        "orchestrator",
        "compiler",
        "adapter",
        "lifecycle"
      ]
    },
    "traits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "determinism",
        "mutation_scope",
        "state_model",
        "risk_class",
        "externality",
        "evidence_mode",
        "execution_shape"
      ],
      "properties": {
        "determinism": {
          "enum": [
            "llm",
            "code",
            "mixed"
          ]
        },
        "mutation_scope": {
          "enum": [
            "none",
            "artifact_only",
            "repo_scoped",
            "external"
          ]
        },
        "state_model": {
          "enum": [
            "stateless",
            "ephemeral",
            "resumable",
            "durable"
          ]
        },
        "risk_class": {
          "enum": [
            "reversible",
            "guarded",
            "irreversible"
          ]
        },
        "externality": {
          "enum": [
            "local",
            "repo",
            "network",
            "third_party"
          ]
        },
        "evidence_mode": {
          "enum": [
            "none",
            "source_grounded",
            "runtime_observed",
            "mixed"
          ]
        },
        "execution_shape": {
          "enum": [
            "direct",
            "pipeline",
            "dag",
            "state_machine"
          ]
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "decided_by": {
      "enum": [
        "deterministic_rule",
        "bounded_llm"
      ]
    },
    "rule_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}
