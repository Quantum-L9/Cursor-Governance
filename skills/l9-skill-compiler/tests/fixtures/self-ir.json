{
  "identity": {
    "name": "l9-skill-compiler",
    "version": "2.0.0",
    "updated": "2026-08-26"
  },
  "objective": "Compile, rebuild, evolve, or validate reusable L9 Skills through a topology-aware, type-aware DAG runtime with deterministic validation and Capability Closure.",
  "activation": [
    "Creating, compiling, materially rebuilding, evolving, or validating a reusable Skill",
    "Deciding whether to extend, compose, replace, reject, or create a Skill",
    "Designing a Skill runtime, capability bindings, or target profile rendering",
    "Producing activation or behavior evaluation evidence for a Skill"
  ],
  "non_activation": [
    "Merely wiring an existing pack into a repo",
    "Authoring a generic L9 DAG",
    "Performing generic reasoning methodology",
    "Producing next-prompt behavior",
    "Executing a domain task already owned by a more specific Skill"
  ],
  "primary_family": "compiler",
  "traits": {
    "determinism": "mixed",
    "mutation_scope": "artifact_only",
    "state_model": "ephemeral",
    "risk_class": "guarded",
    "externality": "repo",
    "evidence_mode": "mixed",
    "execution_shape": "dag"
  },
  "authority": {
    "role": "skill_compiler_runtime",
    "owner": "igor_beylin",
    "tags": [
      "l9",
      "compiler",
      "skill",
      "ir",
      "capability-closure",
      "dag"
    ],
    "canonical_dag": "workflows/dags/skill_compiler_dag.py",
    "dag_registry_id": "skill-compiler-v2",
    "dag_authority_owner": "l9-dag-authoring",
    "activation_triggers": [
      "compile a skill",
      "rebuild the skill",
      "create a new skill",
      "validate a skill pack",
      "evolve a skill"
    ],
    "non_activation_triggers": [
      "wire the skill",
      "author a dag",
      "reasoning methodology",
      "next prompt"
    ]
  },
  "inputs": [
    {
      "id": "compile_request",
      "schema": "contracts/compile-request.schema.json"
    }
  ],
  "outputs": [
    {
      "id": "skill_ir",
      "schema": "contracts/skill-ir.schema.json"
    },
    {
      "id": "build_receipt",
      "schema": "contracts/build-receipt.schema.json"
    },
    {
      "id": "closure_result",
      "schema": "contracts/capability-closure.schema.json"
    }
  ],
  "invariants": [
    "Source material compiles into Skill IR before any file is rendered",
    "Deterministic work is executable code and never LLM narration",
    "One primary family plus orthogonal traits determines runtime and required evals",
    "Platform conventions live in target profiles, never in universal Skill semantics",
    "Every required capability is closed or explicitly runtime-bound",
    "Fail closed on material UNKNOWN",
    "Repo wiring remains owned by l9-wire-skill-into-repo",
    "DAG authoring mechanics remain owned by l9-dag-authoring"
  ],
  "resources": [
    {
      "kind": "policy",
      "ref": "policies/capability-closure.yaml"
    },
    {
      "kind": "policy",
      "ref": "policies/target-profiles.yaml"
    }
  ],
  "dependencies": [
    {
      "skill": "l9-dag-authoring",
      "relation": "consumes"
    },
    {
      "skill": "l9-wire-skill-into-repo",
      "relation": "delegates_to"
    },
    {
      "skill": "l9-structured-reasoning",
      "relation": "mines_invariants_only"
    }
  ],
  "risks": [
    {
      "id": "scope_drift",
      "mitigation": "static_validate rejects out-of-partition nodes"
    },
    {
      "id": "platform_rule_leak",
      "mitigation": "unverified profiles are gated by policy"
    }
  ],
  "evidence": [
    {
      "claim": "canonical DAG dir is workflows/dags",
      "source_ref": "skills/l9-dag-authoring/SKILL.md + observed workflows/dags layout"
    }
  ],
  "unknowns": [],
  "target_profiles": [
    "portable",
    "l9"
  ],
  "capabilities": [
