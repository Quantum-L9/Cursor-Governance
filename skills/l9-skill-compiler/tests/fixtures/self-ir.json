      "required": true,
      "binding": {
        "kind": "EXECUTABLE",
        "target": "workflows/dags/skill_compiler_runner.py",
        "success_condition": "resolves the canonical graph and returns a terminal state from TERMINAL_STATES",
        "failure_behavior": "raises before execution when the graph does not validate",
        "depends_on": []
      }
    },
