{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l9.cto-train/v1",
  "title": "CTO merge-train manifest",
  "description": "The CTO's ordered merge plan for one campaign, read by ops/autonomy/cto_train.py. File: <workspace>/.l9/cto-mode/train.json. Frozen shared interface of campaign cto-workflow-v1 (lane A); `accepted` is the lane's declared extension. The manifest grants no permission: every merge still goes through stack_safe_merge.py and merge_gate.",
  "type": "object",
  "required": ["schema", "campaign", "repo", "base", "prs", "order"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "l9.cto-train/v1" },
    "campaign": { "type": "string", "minLength": 1 },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
    "base": { "type": "string", "minLength": 1 },
    "prs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["number", "lane", "proven_head"],
        "additionalProperties": false,
        "properties": {
          "number": { "type": "integer", "minimum": 1 },
          "lane": { "type": "string" },
          "proven_head": {
            "oneOf": [{ "type": "string", "pattern": "^[0-9a-f]{40}$" }, { "type": "null" }]
          }
        }
      }
    },
    "order": {
      "description": "Merge order (bottom-up). Every PR in `prs` appears exactly once.",
      "type": "array",
      "items": { "type": "integer", "minimum": 1 }
    },
    "pairs": {
      "description": "Land-together groups. Each group lands back to back, and none of its members merges until every member is clean and checked.",
      "type": "array",
      "default": [],
      "items": {
        "type": "array",
        "minItems": 2,
        "items": { "type": "integer", "minimum": 1 }
      }
    },
    "integration_receipt": {
      "description": "Path (absolute, or relative to the workspace) of an l9.cto-integration-receipt/v1 file that must exist, pass, and cover the proven heads.",
      "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }]
    },
    "runtime": {
      "oneOf": [
        {
          "type": "object",
          "required": ["command"],
          "properties": {
            "command": { "type": "array", "items": { "type": "string" } },
            "env": { "type": "object", "additionalProperties": { "type": "string" } },
            "timeout_s": { "type": "integer", "minimum": 1 }
          }
        },
        { "type": "null" }
      ]
    },
    "static": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "string" } }
    },
    "suite": {
      "type": "array",
      "items": { "type": "array", "items": { "type": "string" } }
    },
    "accepted": {
      "description": "Reviewed acceptances: a live head the CTO reviewed and accepted although it is neither the proven head nor mechanically equivalent to it.",
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "required": ["pr", "head_prefix", "reason"],
        "additionalProperties": false,
        "properties": {
          "pr": { "type": "integer", "minimum": 1 },
          "head_prefix": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
