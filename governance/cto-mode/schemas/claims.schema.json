{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Quantum-L9/Cursor-Governance/governance/cto-mode/schemas/claims.schema.json",
  "title": "l9.cto-claims/v1",
  "description": "One CTO campaign's advisory lane claim on one repository, stored as a fenced JSON block in that campaign's comment on the repository's 'L9 CTO lane registry' issue. Maintained by ops/autonomy/cto_claims.py. A claim is not a lock and grants no permission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "campaign", "cto_session", "repo", "base", "lanes", "updated_at"],
  "properties": {
    "schema": { "const": "l9.cto-claims/v1" },
    "campaign": { "type": "string", "minLength": 1 },
    "cto_session": { "type": "string", "minLength": 1 },
    "repo": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
    "base": { "type": "string", "minLength": 1 },
    "lanes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["lane", "paths", "pr", "state"],
        "properties": {
          "lane": { "type": "string", "minLength": 1 },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "pr": { "type": ["integer", "null"], "minimum": 1 },
          "state": { "enum": ["planned", "active", "published", "merged", "released"] }
        }
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "paths", "text", "created_at", "affected"],
        "properties": {
          "kind": { "enum": ["base-change", "interface-change", "gate-change"] },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "text": { "type": "string", "minLength": 1 },
          "created_at": { "type": "string", "minLength": 1 },
          "affected": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["campaign", "cto_session", "lanes"],
              "properties": {
                "campaign": { "type": "string" },
                "cto_session": { "type": "string" },
                "lanes": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "updated_at": { "type": "string", "minLength": 1 }
  }
}
