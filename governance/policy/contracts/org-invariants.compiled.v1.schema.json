{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "l9/org-invariants/compiled/v1",
  "title": "L9 Compiled Organization Invariants v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "organization", "policy_digest", "source_transaction_digest", "status", "invariants", "retired_ids"],
  "properties": {
    "schema": {"const": "l9.org-invariants.compiled.v1"},
    "organization": {"const": "Quantum-L9"},
    "policy_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source_transaction_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "status": {"const": "active"},
    "invariants": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "statement", "applicability", "relationships", "bindings", "verifiers", "projection", "source_change_ids", "invariant_digest"],
        "properties": {
          "id": {"type": "string", "pattern": "^L9-ORG-[0-9]{3,}$"},
          "title": {"type": "string", "minLength": 1},
          "statement": {"type": "string", "minLength": 1},
          "applicability": {"type": "string", "minLength": 1},
          "relationships": {"type": "array"},
          "bindings": {"type": "array"},
          "verifiers": {"type": "array"},
          "projection": {"type": "object"},
          "source_change_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
          "invariant_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "retired_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^L9-ORG-[0-9]{3,}$"}}
  }
}
