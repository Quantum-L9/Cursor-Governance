      "mutation_parallelism": "bounded_lanes",
      "model_policy": "surface_default",
      "workflow_size_guideline": null,
      "max_parallel": 4,
      "max_mutation_lanes": 2,
      "native_subagent_limit": null,
      "subagent_spawn_depth": null
    },
    "claude_local": {
      "execution_profile": "maximum_velocity",
      "concurrency_policy": "saturate",
      "parallel_read": "maximum_legal",
      "mutation_parallelism": "max_non_conflicting",
      "model_policy": "best_available_per_role",
      "workflow_size_guideline": "unrestricted",
      "max_parallel": 480,
      "max_mutation_lanes": 128,
      "native_subagent_limit": 480,
      "subagent_spawn_depth": 3
    },
    "claude_cloud": {
      "execution_profile": "maximum_velocity",
      "concurrency_policy": "saturate",
      "parallel_read": "maximum_legal",
      "mutation_parallelism": "max_non_conflicting",
      "model_policy": "best_available_per_role",
      "workflow_size_guideline": "unrestricted",
      "max_parallel": 480,
      "max_mutation_lanes": 128,
      "native_subagent_limit": 480,
      "subagent_spawn_depth": 3
    }
