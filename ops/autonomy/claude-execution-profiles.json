    }
  },

  "native_defaults": {
    "_doc": "Claude Code defaults these variables when unset (code.claude.com/docs/en/agent-sdk/subagents). Left unset they become the effective ceiling.",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": 20,
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": 3,
    "workflowSizeGuideline": "medium"
  }
}
