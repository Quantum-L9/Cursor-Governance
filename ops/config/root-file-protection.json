{
  "schema_version": "1.0.0",
  "description": "Append-only protection contract for repository-root files. Incoming pull requests may freely ADD content to a protected root file, but may not delete or overwrite existing content without an explicit, proof-carrying justification recorded in a commit message AND CODEOWNERS review. This is the declarative source of truth read by ops/scripts/validate_root_file_protection.py (the fail-closed CI gate). Review routing is registered separately in CODEOWNERS and ORG_INVARIANTS.yaml protected_paths.",
  "rules": {
    "additive_only": "A PR may only add lines. Any removal or in-place rewrite of an existing line (or deletion of the whole file) fails the gate unless a matching justification marker is present in the PR's commit messages. Purely additive changes and brand-new files pass. CODEOWNERS review is still required.",
    "regenerable": "Machine-generated artifact that is rewritten wholesale by tooling; exempt from the additive check because append-only is meaningless for it. Still CODEOWNERS-reviewed so a human sees the regeneration."
  },
  "justification": {
    "marker": "ALLOW-ROOT-DELETION",
    "format": "ALLOW-ROOT-DELETION: <root-relative-path> — <reason with proof of necessity>",
    "recorded_in": "any commit message in the PR range (base..head)",
    "note": "The marker authorizes the gate only; it does not replace human CODEOWNERS approval. It exists so every non-additive change to a protected root file carries a highlighted delta and a documented, traceable rationale."
  },
  "tiers": {
    "canonical": "Hand-authored governance/contract/config surface. additive_only.",
    "regenerable": "Machine-generated artifact. regenerable."
  },
  "protected_files": [
    { "path": ".editorconfig", "tier": "canonical", "rule": "additive_only" },
