{
  "_comment": "Remote MCP servers whose credential is bound from Infisical by ops/secrets/vault_mcp_bridge.py. Names and hosts only — never a value. `format` renders the header value from the bound secret.",
  "bridges": {
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "secret": "CONTEXT7_API_KEY",
      "header": "CONTEXT7_API_KEY",
      "format": "{value}"
    }
  },
  "spawns": {
    "perplexity": {
      "command": "npx",
      "args": [
        "-y",
        "perplexity-mcp"
      ],
      "env": {
        "PERPLEXITY_API_KEY": "PERPLEXITY_API_KEY"
      }
    },
    "notion": {
      "command": "npx",
      "args": [
        "-y",
        "@notionhq/notion-mcp-server"
      ],
      "env": {
        "NOTION_API_KEY": "NOTION_API_KEY"
      }
    },
    "n8n": {
      "command": "npx",
      "args": [
        "n8n-mcp"
      ],
      "env": {
        "N8N_API_KEY": "N8N_API_KEY",
        "N8N_API_URL": "N8N_API_URL"
      },
      "literal_env": {
        "MCP_MODE": "stdio",
        "LOG_LEVEL": "error",
        "DISABLE_CONSOLE_OUTPUT": "true"
      }
    },
    "semgrep": {
      "command": "semgrep",
      "args": [
        "mcp"
      ],
      "env": {
        "SEMGREP_APP_TOKEN": "SEMGREP_APP_TOKEN"
      }
    },
    "github": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-github"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "GITHUB_TOKEN"
      }
    }
  }
}
