#!/usr/bin/env bash
# l9-render-env - render a systemd EnvironmentFile from an Infisical project.
#
# Runs as root from a oneshot unit immediately before the service that consumes it. It speaks the
# Infisical HTTP API directly (curl + jq), so the host needs no CLI, no Node profile and no
# interactive login: the machine identity is a Universal Auth client id/secret in a root-only file.
#
# The rendered file is 0600 root:root. systemd reads it as root and passes the values into the
# service environment, so the service user never reads the file and the plaintext lives only on
# tmpfs. Only key names and counts are printed: values never reach the terminal or the journal.
#
#   l9-render-env --project <id> --out /run/l9/splitwisely.env
#                 [--env prod] [--path /] [--prefix SPLITWISELY_] [--creds <file>] [--api <url>]
#
# Environment:
#   INFISICAL_API_URL      default https://app.infisical.com/api
#   INFISICAL_CREDS_FILE   default /etc/l9/infisical-splitwisely.env
#
# Exit status is non-zero on any failure, and a failed run leaves no file behind, so a service that
# requires this unit fails closed instead of starting with stale values.
set -euo pipefail
umask 077

API=${INFISICAL_API_URL:-https://app.infisical.com/api}
CREDS=${INFISICAL_CREDS_FILE:-/etc/l9/infisical-splitwisely.env}
PROJECT=
ENVIRONMENT=prod
SECRET_PATH=/
OUT=
PREFIX=

die() {
  printf 'l9-render-env: error: %s\n' "$*" >&2
  exit 1
}
note() { printf 'l9-render-env: %s\n' "$*" >&2; }

usage() {
  awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "$0"
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --project) PROJECT=${2:-}; shift 2 ;;
    --env) ENVIRONMENT=${2:-}; shift 2 ;;
    --path) SECRET_PATH=${2:-}; shift 2 ;;
    --out) OUT=${2:-}; shift 2 ;;
    --prefix) PREFIX=${2:-}; shift 2 ;;
    --creds) CREDS=${2:-}; shift 2 ;;
    --api) API=${2:-}; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    *) die "unknown argument: $1 (try --help)" ;;
  esac
done

[ -n "$PROJECT" ] || die "--project is required"
[ -n "$OUT" ] || die "--out is required"
command -v curl >/dev/null 2>&1 || die "curl not found"
command -v jq >/dev/null 2>&1 || die "jq not found (apt-get install -y jq)"
[ -r "$CREDS" ] || die "credentials file not readable: $CREDS"

# Parsed, not sourced: a credentials file is data, and sourcing it would execute whatever it holds.
client_id=$(sed -n 's/^INFISICAL_CLIENT_ID=//p' "$CREDS" | tail -n 1 | tr -d '"')
client_secret=$(sed -n 's/^INFISICAL_CLIENT_SECRET=//p' "$CREDS" | tail -n 1 | tr -d '"')
[ -n "$client_id" ] || die "INFISICAL_CLIENT_ID missing from $CREDS"
[ -n "$client_secret" ] || die "INFISICAL_CLIENT_SECRET missing from $CREDS"

work=$(mktemp -d "${TMPDIR:-/tmp}/l9-render-env.XXXXXX")
cleanup() { rm -rf "$work"; }
tmp="$OUT.tmp.$$"
trap 'rm -f "$tmp"; cleanup' EXIT
trap 'rm -f "$tmp"; cleanup; exit 130' INT
trap 'rm -f "$tmp"; cleanup; exit 143' TERM

# The secret is handed to curl on stdin, never in argv: /proc/<pid>/cmdline is world-readable.
jq -nc --arg id "$client_id" --arg secret "$client_secret" \
  '{clientId: $id, clientSecret: $secret}' >"$work/login.json"
code=$(curl -sS -o "$work/login.out" -w '%{http_code}' -X POST \
  "$API/v1/auth/universal-auth/login" \
  -H 'Content-Type: application/json' --data-binary "@$work/login.json") ||
  die "cannot reach $API"
[ "$code" = "200" ] || die "universal-auth login failed (HTTP $code): $(head -c 200 "$work/login.out")"
token=$(jq -r '.accessToken // empty' "$work/login.out")
[ -n "$token" ] || die "login returned no accessToken"

encoded_path=$(jq -rn --arg v "$SECRET_PATH" '$v | @uri')
url="$API/v3/secrets/raw?workspaceId=$PROJECT&environment=$ENVIRONMENT&secretPath=$encoded_path"
code=$(curl -sS -o "$work/secrets.json" -w '%{http_code}' \
  -H "Authorization: Bearer $token" "$url") || die "cannot reach $API"
[ "$code" = "200" ] || die "reading secrets failed (HTTP $code): $(head -c 200 "$work/secrets.json")"

# The value travels as base64 so a quote, a backslash or a newline in it cannot break the parse.
jq -r --arg p "$PREFIX" '
  .secrets[]
  | select($p == "" or (.secretKey | startswith($p)))
  | "\(.secretKey)\t\(.secretValue | @base64)"
' "$work/secrets.json" >"$work/pairs"

count=$(wc -l <"$work/pairs" | tr -d ' ')
[ "$count" -gt 0 ] ||
  die "no secrets matched in project $PROJECT (env $ENVIRONMENT, path $SECRET_PATH, prefix '${PREFIX}')"

dir=$(dirname "$OUT")
mkdir -p "$dir"
chmod 700 "$dir"
: >"$tmp"
chmod 600 "$tmp"

keys=
tab=$(printf '\t')
while IFS="$tab" read -r key encoded; do
  case "$key" in '' | *[!A-Za-z0-9_]*) die "refusing to render invalid key name: $key" ;; esac
  case "$key" in [0-9]*) die "refusing to render key starting with a digit: $key" ;; esac
  value=$(printf '%s' "$encoded" | base64 -d)
  case "$value" in
    *$'\n'*) die "value for $key contains a newline, which an EnvironmentFile cannot carry" ;;
  esac
  # EnvironmentFile quoting: inside double quotes only backslash and double quote carry meaning.
  # systemd does not expand variables in these files, so $ and ` stay literal, as stored.
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '%s="%s"\n' "$key" "$value" >>"$tmp"
  keys="$keys $key"
done <"$work/pairs"

mv "$tmp" "$OUT"
note "rendered $count keys from $PROJECT (env $ENVIRONMENT, path $SECRET_PATH) to $OUT:$keys"
