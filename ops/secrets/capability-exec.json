{
  "schema": "l9.capability-exec.v1",
  "_comment": "Allowlisted child-process executions that need one vault secret. argv is fixed; only declared {placeholders} are substituted, each by a named validator. The secret is bound in-process by capability_bind and placed ONLY in that child's environment. See AGENTS.md CI_PARITY_HOSTED_CLAUDE_V1.",
  "entries": {
    "semgrep-pro": {
      "secret": "SEMGREP_APP_TOKEN",
      "env": "SEMGREP_APP_TOKEN",
      "argv": [
        "semgrep",
        "ci",
        "--dry-run",
        "--sarif",
        "--sarif-output={output}",
        "--baseline-commit={baseline}",
        "--metrics=off",
        "--disable-version-check"
      ],
      "fixed_env": {
        "SEMGREP_REPO_NAME": "{repo}",
        "SEMGREP_SEND_METRICS": "off"
      },
      "params": {
        "output": "cache_path",
        "baseline": "git_sha",
        "repo": "repo_slug"
      },
      "cwd": "cache_dir",
      "outputs": ["output"],
      "timeout_seconds": 1800
    }
  }
}
