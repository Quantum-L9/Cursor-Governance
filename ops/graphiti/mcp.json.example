{
  "_comment": [
    "AUTHORITATIVE Graphiti MCP shape (Cursor + Claude adapters).",
    "Front door: graphiti-memory @ 127.0.0.1:8100 via SSH tunnel + GRAPHITI_MCP_TOKEN.",
    "Claude Code copies the same block from environment/agents/adapters/claude-code/mcp.template.json.",
    "Retired: l9-shared-memory @ https://memory.quantumaipartners.com (HTTP side door)."
  ],
  "mcpServers": {
    "graphiti-memory": {
      "url": "http://127.0.0.1:8100/mcp/",
      "headers": {
        "Authorization": "Bearer ${GRAPHITI_MCP_TOKEN}"
      }
    }
  }
}
